<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Disponibilidad de salones | HelpingBee</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/GestionRentas.css">
</head>
<body>
<%- include('partials/GestionRentasNav',{regreso:'/rentas/eventos',etiquetaRegreso:'Menú de eventos'}) %>
<main class="container-fluid hb-main px-3 px-lg-4 py-4">
    <div class="hb-crumb mb-3"><a href="/rentas">Rentas</a> / <a href="/rentas/eventos">Eventos</a> / Disponibilidad</div>
    <p class="hb-kicker mb-1">Agenda de salones</p>
    <h1 class="hb-heading h2">Disponibilidad</h1>
    <p class="hb-intro">Consulta los horarios ocupados y libres de los salones, sin registrar un evento ni elegir un paquete.</p>
    <div class="hb-tabs"><a href="/rentas/eventos/reservaciones"><i class="bi bi-calendar-plus me-1"></i>Nueva reservación</a><a class="active" aria-current="page" href="/rentas/gestion/eventos/calendario"><i class="bi bi-calendar-week me-1"></i>Disponibilidad</a><a href="/rentas/eventos/reservaciones/historial"><i class="bi bi-clipboard-check me-1"></i>Mis reservaciones</a>
    </div>
    <div id="errorAgenda" class="alert alert-danger" role="alert" hidden></div>
    <div class="row g-3 g-xl-4">
        <div class="col-xl-7">
            <section class="hb-panel h-100">
                <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <p class="hb-kicker mb-1">Calendario mensual</p>
                        <h2 class="h5 fw-bold text-capitalize mb-0" id="tituloMes">Cargando…</h2>
                    </div>
                    <div class="btn-group">
                        <button type="button" id="anterior" class="btn btn-outline-primary" aria-label="Mes anterior">‹</button>
                        <button type="button" id="hoy" class="btn btn-outline-primary">Hoy</button>
                        <button type="button" id="siguiente" class="btn btn-outline-primary" aria-label="Mes siguiente">›</button>
                    </div>
                </div>
                <label class="form-label" for="filtroSalon">Filtrar salón</label>
                <select id="filtroSalon" class="form-select mb-3">
                    <option value="">Todos los salones</option>
                </select>
                <div id="calendario" class="hb-calendar" aria-label="Calendario de reservaciones"></div>
                <div class="small text-muted mt-3"><span class="d-inline-block rounded me-1" style="background:#f0e8fc;width:13px;height:13px"></span> Día con una o más reservaciones. No significa que esté ocupado todo el día.</div>
            </section>
        </div>
        <div class="col-xl-5">
            <section class="hb-panel mb-3">
                <p class="hb-kicker mb-1">Día seleccionado</p>
                <h2 id="tituloDia" class="h5 fw-bold text-capitalize mb-3">Selecciona una fecha</h2>
                <div id="agendaDia" aria-live="polite">
                </div>
            </section>
            <section class="hb-panel">
                <h2 class="h5 fw-bold">Consultar un horario</h2>
                <p class="small text-muted">Comprueba los salones disponibles para el intervalo del día seleccionado.</p>
                <div class="row g-2 mb-3">
                    <label class="col-6">Inicio<input class="form-control" id="horaInicio" type="time" value="12:00" required>
                </label>
                <label class="col-6">Fin<input class="form-control" id="horaFin" type="time" value="16:00" required>
                </label>
                </div>
                <div id="resultadoHorario" aria-live="polite"></div>
                <a id="nuevaReserva" class="btn btn-morado w-100 mt-3" href="/rentas/eventos/reservaciones" hidden><i class="bi bi-calendar-plus me-1"></i> Ir a nueva reservación</a>
                <p class="small text-muted mt-2 mb-0">La disponibilidad definitiva se vuelve a validar al contratar. Aquí solo se consulta la agenda de salones.</p>
            </section>
        </div>
    </div>
</main>
<footer class="hb-footer">HelpingBee · Agenda de eventos</footer>
<script>
(() => {
    const el = id => document.getElementById(id);
    const fechaHoy = new Date().toLocaleDateString('sv-SE', { timeZone: 'America/Mexico_City' });
    const ahoraLocal = () => new Intl.DateTimeFormat('sv-SE', { timeZone: 'America/Mexico_City', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' }).format(new Date()).replace(' ', 'T');
    let mes = fechaHoy.slice(0, 7), dia = fechaHoy, datos = null, secuencia = 0;
    const fechaEtiqueta = s => new Date(s + 'T12:00:00').toLocaleDateString('es-MX', { dateStyle: 'full' });
    const diaSiguiente = s => {
        const d = new Date(s + 'T00:00:00Z');
        d.setUTCDate(d.getUTCDate() + 1);
        return d.toISOString().slice(0, 10);
    };
    const fechaHora = s => s.replace('T', ' ').slice(0, 16);
    const cruza = (r, inicio, fin) => r.inicio < fin && r.fin > inicio;
    const ocupantes = () => datos.reservaciones.filter(r => r.estado !== 'Cancelada' && (!el('filtroSalon').value || String(r.salon_id) === el('filtroSalon').value));

    function crear(tag, clase, texto) {
        const n = document.createElement(tag);
        if (clase)
            n.className = clase;
        if (texto !== undefined)
            n.textContent = texto;
        return n;
    }

    function error(texto) {
        el('errorAgenda').hidden = !texto;
        el('errorAgenda').textContent = texto || '';
    }

    function pintar() {
        if (!datos)
            return;
        const [anio, m] = mes.split('-').map(Number), primer = new Date(anio, m - 1, 1), numeroDias = new Date(anio, m, 0).getDate(), offset = (primer.getDay() + 6) % 7;
        el('tituloMes').textContent = primer.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });
        const cal = el('calendario');
        cal.replaceChildren();
        ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'].forEach(x => cal.appendChild(crear('div', 'hb-week', x)));
        for (let i = 0; i < offset; i++)
            cal.appendChild(crear('div', 'hb-day empty'));
        const reservas = ocupantes();
        for (let i = 1; i <= numeroDias; i++) {
            const f = mes + '-' + String(i).padStart(2, '0'), cantidad = reservas.filter(r => cruza(r, f + 'T00:00:00', diaSiguiente(f) + 'T00:00:00')).length;
            const b = crear('button', 'hb-day' + (cantidad ? ' busy' : '') + (dia === f ? ' selected' : ''));
            b.type = 'button';
            b.setAttribute('aria-pressed', String(dia === f));
            b.setAttribute('aria-label', fechaEtiqueta(f) + ', ' + cantidad + ' reservaciones');
            b.append(crear('strong', '', String(i)));
            if (cantidad)
                b.append(crear('small', '', cantidad + ' reserva(s)'));
            b.addEventListener('click', () => {
                dia = f;
                pintar();
            });
            cal.appendChild(b);
        }
        pintarDia();
    }

    function pintarDia() {
        if (!datos)
            return;
        el('tituloDia').textContent = fechaEtiqueta(dia);
        const cont = el('agendaDia');
        cont.replaceChildren();
        const reservas = ocupantes().filter(r => cruza(r, dia + 'T00:00:00', diaSiguiente(dia) + 'T00:00:00'));
        if (!reservas.length)
            cont.append(crear('p', 'small text-muted mb-0', 'No hay reservaciones no canceladas para esta fecha y filtro.'));
        reservas.forEach(r => {
            const item = crear('article', 'hb-agenda-item');
            item.append(crear('strong', 'd-block', r.salon), crear('span', 'small text-muted d-block', `#${r.reservacion_id} · ${r.nombre_evento || 'Evento'} · ${r.estado}`), crear('span', 'small d-block mt-1', fechaHora(r.inicio) + ' — ' + fechaHora(r.fin)));
            cont.append(item);
        });
        pintarHorario();
    }

    function pintarHorario() {
        const cont = el('resultadoHorario'), enlace = el('nuevaReserva');
        cont.replaceChildren();
        enlace.hidden = true;
        if (!datos)
            return;
        const ini = el('horaInicio').value, fin = el('horaFin').value;
        if (!ini || !fin || fin <= ini) {
            cont.append(crear('p', 'text-danger small', 'Selecciona una hora de fin posterior a la de inicio.'));
            return;
        }
        const inicio = dia + 'T' + ini + ':00', final = dia + 'T' + fin + ':00', pasado = inicio <= ahoraLocal();
        const seleccion = el('filtroSalon').value, salones = datos.salones.filter(s => !seleccion || String(s.id) === seleccion);
        let libres = 0;
        salones.forEach(s => {
            const ocupado = datos.reservaciones.some(r => r.estado !== 'Cancelada' && Number(r.salon_id) === Number(s.id) && cruza(r, inicio, final));
            const activo = Number(s.activo) === 1;
            const etiqueta = !activo ? 'Inactivo' : ocupado ? 'Ocupado' : pasado ? 'Horario pasado' : 'Libre en agenda';
            if (activo && !ocupado && !pasado)
                libres++;
            const item = crear('div', 'hb-agenda-item d-flex flex-wrap justify-content-between align-items-center gap-2');
            const info = crear('div');
            info.append(crear('strong', 'd-block', s.nombre), crear('small', 'text-muted', s.capacidad + ' invitados'));
            item.append(info, crear('span', !activo || pasado && !ocupado ? 'hb-status-off' : ocupado ? 'hb-status-busy' : 'hb-status-free', etiqueta));
            cont.append(item);
        });
        if (!salones.length)
            cont.append(crear('p', 'small text-muted', 'No hay salones registrados para mostrar.'));
        if (libres) {
            enlace.href = '/rentas/eventos/reservaciones?' + new URLSearchParams({ fecha_evento: dia, hora_inicio: ini, hora_fin: fin });
            enlace.hidden = false;
        }
    }

    async function cargar() {
        const token = ++secuencia;
        datos = null;
        error('');
        el('calendario').replaceChildren(crear('p', 'small text-muted', 'Cargando…'));
        el('agendaDia').textContent = 'Cargando…';
        el('resultadoHorario').replaceChildren();
        el('nuevaReserva').hidden = true;
        try {
            const r = await fetch('/rentas/gestion/eventos/calendario/datos?' + new URLSearchParams({ mes }), { cache: 'no-store' });
            const j = await r.json();
            if (!r.ok)
                throw new Error(j.error || 'No se pudo cargar la agenda.');
            if (token !== secuencia)
                return;
            if (!Array.isArray(j.salones) || !Array.isArray(j.reservaciones))
                throw new Error('Respuesta de agenda inválida.');
            datos = j;
            const select = el('filtroSalon'), previo = select.value;
            select.replaceChildren(new Option('Todos los salones', ''));
            j.salones.forEach(s => select.append(new Option(s.nombre + (Number(s.activo) !== 1 ? ' (Inactivo)' : ''), s.id)));
            if (j.salones.some(s => String(s.id) === previo))
                select.value = previo;
            pintar();
        }
        catch (e) {
            if (token === secuencia) {
                error(e.message);
                el('agendaDia').textContent = 'No se pudo cargar el día.';
                el('calendario').replaceChildren();
            }
        }
    }

    function mover(n) {
        const [a, m] = mes.split('-').map(Number), d = new Date(a, m - 1 + n, 1);
        mes = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
        dia = mes + '-01';
        cargar();
    }
    el('anterior').addEventListener('click', () => mover(-1));
    el('siguiente').addEventListener('click', () => mover(1));
    el('hoy').addEventListener('click', () => {
        mes = fechaHoy.slice(0, 7);
        dia = fechaHoy;
        cargar();
    });
    el('filtroSalon').addEventListener('change', pintar);
    ['horaInicio', 'horaFin'].forEach(id => el(id).addEventListener('input', pintarHorario));
    cargar();
})();

</script>
</body></html>
