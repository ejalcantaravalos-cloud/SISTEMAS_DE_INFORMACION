
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Productos y Platillos</title>
    <link rel="stylesheet" href="/css/MenuStyles.css">
</head>

<body class="admin-body">

<div class="admin-container">

    <!-- Encabezado -->
    <div class="admin-header">
        <h1>Gestión de Platillos y Menús</h1>
        <span class="admin-badge">
            Admin: <%= user.email %>
        </span>
    </div>

    <!-- Barra de herramientas -->
    <div class="toolbar">
        <span class="count">
            <%= productos.length %> platillo(s) registrado(s)
        </span>

        <div style="display: flex; gap: 10px;">
            <a href="/admin/menu/categorias"
               class="btn-sm btn-outline"
               style="text-decoration: none;">
                Ir a Categorías
            </a>

            <a href="/admin"
               class="btn-sm btn-outline"
               style="text-decoration: none;">
                ← Panel Principal
            </a>
        </div>
    </div>

    <!-- Tabla de platillos -->
    <div class="panel" style="overflow-x: auto;">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Platillo</th>
                    <th>Categoría / Menú</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th>Especial</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                <% if (productos.length === 0) { %>
                    <tr>
                        <td colspan="8"
                            style="text-align: center; color: #888; padding: 20px;">
                            No hay platillos registrados todavía.
                        </td>
                    </tr>

                <% } else { %>

                    <% productos.forEach(p => { %>
                        <tr>
                            <td>#<%= p.id %></td>

                            <td>
                                <strong><%= p.nombre %></strong>
                            </td>

                            <td>
                                <span class="tag tag-admin">
                                    <%= p.categoria_nombre || 'Sin categoría' %>
                                </span>
                            </td>

                            <td>
                                $<%= Number(p.precio).toFixed(2) %>
                            </td>

                            <td><%= p.stock %></td>

                            <td>
                                <span class="tag <%= p.activo ? 'tag-admin' : 'tag-cliente' %>">
                                    <%= p.activo ? 'Activo' : 'Inactivo' %>
                                </span>
                            </td>

                            <td>
                                <span class="tag <%= p.especial ? 'tag-especial' : 'tag-no-especial' %>">
                                    <%= p.especial ? '⭐ Sí' : 'No' %>
                                </span>
                            </td>

                            <!-- Botones de acciones -->
                            <td style="text-align: right;">

                                <div class="actions"
                                     style="display: flex; flex-wrap: wrap; gap: 5px; justify-content: flex-end;">

                                    <!-- Especial -->
                                    <a href="/admin/menu/productos/especial/<%= p.id %>"
                                       class="btn-sm btn-outline"
                                       style="text-decoration: none;"
                                       title="Cambiar estatus de especial">

                                        <%= p.especial ? '⭐' : ' 🌟' %>
                                    </a>

                                    <!-- Activar / Desactivar -->
                                    <a href="/admin/menu/productos/toggle/<%= p.id %>"
                                       class="btn-sm <%= p.activo ? 'btn-danger' : 'btn-primary' %>"
                                       style="text-decoration: none;">

                                        <%= p.activo ? 'Desactivar' : 'Activar' %>
                                    </a>

                                    <!-- EDITAR -->
                                    <button
                                        type="button"
                                        class="btn-sm btn-outline btn-editar-producto"

                                        data-id="<%= p.id %>"
                                        data-nombre="<%= p.nombre %>"
                                        data-precio="<%= p.precio %>"
                                        data-stock="<%= p.stock %>"
                                        data-categoria="<%= p.categoria_id || '' %>">

                                        ✏️ 
                                    </button>

                                    <!-- ELIMINAR -->
                                    <form
                                        action="/admin/menu/productos/eliminar/<%= p.id %>"
                                        method="POST"
                                        enctype="multipart/form-data"
                                        style="display: inline;"
                                        onsubmit="return confirm('¿Seguro que deseas eliminar este platillo?');">

                                        <button type="submit"
                                                class="btn-sm btn-danger">
                                            🗑️ 
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    <% }) %>

                <% } %>
            </tbody>
        </table>
    </div>


    <!-- Formulario para CREAR o EDITAR -->
    <div class="panel"
         id="panelFormulario"
         style="margin-top: 30px;">

        <h3 id="tituloFormulario"
            style="margin-bottom: 15px; font-size: 1.1rem; color: #333;">

            Registrar Nuevo Platillo
        </h3>

        <form
            id="formProducto"
            action="/admin/menu/productos/crear"
            method="POST"
            enctype="multipart/form-data"
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">

            <!-- Nombre -->
            <div class="form-group" style="margin: 0;">
                <label style="font-size: 0.85rem; font-weight: 500;">
                    Nombre del platillo:
                </label>

                <input
                    type="text"
                    name="nombre"
                    placeholder="Ej. Hamburguesa Doble"
                    required
                    style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
            </div>

            <!-- Precio -->
            <div class="form-group" style="margin: 0;">
                <label style="font-size: 0.85rem; font-weight: 500;">
                    Precio ($):
                </label>

                <input
                    type="number"
                    step="0.01"
                    min="0"
                    name="precio"
                    placeholder="120.00"
                    required
                    style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
            </div>

            <!-- Stock -->
            <div class="form-group" style="margin: 0;">
                <label style="font-size: 0.85rem; font-weight: 500;">
                    Stock:
                </label>

                <input
                    type="number"
                    name="stock"
                    min="0"
                    value="15"
                    required
                    style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
            </div>

            <!-- Categoría -->
            <div class="form-group" style="margin: 0;">
                <label style="font-size: 0.85rem; font-weight: 500;">
                    Categoría / Menú:
                </label>

                <select
                    name="categoria_id"
                    required
                    style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">

                    <option value="">Seleccione una categoría</option>

                    <% if (categorias && categorias.length > 0) { %>
                        <% categorias.forEach(cat => { %>
                            <option value="<%= cat.id %>">
                                <%= cat.nombre %>
                            </option>
                        <% }) %>
                    <% } %>

                </select>
            </div>

            <!-- Botones del formulario -->
            <div style="grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;">

                <!-- Fotografía del platillo -->
                <div class="form-group" style="margin: 0;">

                     <label style="font-size: 0.85rem; font-weight: 500;">
                        Fotografía del Platillo:
                    </label>

                    <input
                        type="file"
                                 name="imagen"
                     accept="image/jpeg,image/png,image/webp"
                  style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;"
             >

    <small style="color: #64748b;">
        JPG, PNG o WebP. Máximo 5 MB.
        Al editar, deja el campo vacío para conservar la fotografía actual.
    </small>

</div>

                <button
                    type="button"
                    id="cancelarEdicion"
                    class="btn-sm btn-outline"
                    style="padding: 10px 20px; cursor: pointer;"
                    hidden>

                    Cancelar edición
                </button>
                

                <button
                    type="submit"
                    id="btnGuardarProducto"
                    class="btn-sm btn-primary"
                    style="padding: 10px 20px; cursor: pointer;">

                    Guardar Platillo
                </button>

            </div>

        </form>
    </div>

</div>

<script> src="/js/AdminProductos.js"</script>

</body>
</html>
