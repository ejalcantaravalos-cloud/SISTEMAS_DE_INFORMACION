<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Productos y Platillos</title>
  <link rel="stylesheet" href="/MenuStyles.css">
</head>
<body class="admin-body">
  <div class="admin-container">
    <div class="admin-header">
      <h1>Gestión de Platillos y Menús</h1>
      <span class="admin-badge">Admin: <%= user.email %></span>
    </div>

    <!-- Barra de herramientas -->
    <div class="toolbar">
      <span class="count"><%= productos.length %> platillo(s) registrado(s)</span>
      <div style="display: flex; gap: 10px;">
        <a href="/admin/menu/categorias" class="btn-sm btn-outline" style="text-decoration: none;">Ir a Categorías</a>
        <a href="/admin" class="btn-sm btn-outline" style="text-decoration: none;">← Panel Principal</a>
      </div>
    </div>

    <!-- Tabla de Platillos -->
    <div class="panel">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Platillo</th>
            <th>Categoría / Menú</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Estado</th>
            <th>Especial</th>
            <th style="text-align:right;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (productos.length === 0) { %>
            <tr>
              <td colspan="8" style="text-align: center; color: #888; padding: 20px;">No hay platillos registrados todavía.</td>
            </tr>
          <% } else { %>
            <% productos.forEach(p => { %>
              <tr>
                <td>#<%= p.id %></td>
                <td><strong><%= p.nombre %></strong></td>
                <td>
                  <span class="tag tag-admin"><%= p.categoria_nombre || 'Sin categoría' %></span>
                </td>
                <td>$<%= Number(p.precio).toFixed(2) %></td>
                <td><%= p.stock %></td>
                <td>
                  <span class="tag <%= p.activo ? 'tag-admin' : 'tag-cliente' %>">
                    <%= p.activo ? 'Activo' : 'Inactivo' %>
                  </span>
                </td>
                <td>
                 <!-- Platillo Especial o del Día -->
            <span class="tag <%= p.especial ? 'tag-especial' : 'tag-no-especial' %>">
                <%= p.especial ? '⭐ Sí' : 'No' %>
            </span>
                </td>
                <td style="text-align:right;">
                  <div class="actions" style="justify-content: flex-end;">
                    <a href="/admin/menu/productos/especial/<%= p.id %>" class="btn-sm btn-outline" style="text-decoration: none;" title="Cambiar estatus de especial">
                      <%= p.especial ? 'Quitar ⭐' : 'Hacer ⭐' %>
                    </a>
                    <a href="/admin/menu/productos/toggle/<%= p.id %>" class="btn-sm <%= p.activo ? 'btn-danger' : 'btn-primary' %>" style="text-decoration: none;">
                      <%= p.activo ? 'Desactivar' : 'Activar' %>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Formulario para Crear Platillo -->
    <div class="panel" style="margin-top: 30px;">
      <h3 style="margin-bottom: 15px; font-size: 1.1rem; color: #333;">Registrar Nuevo Platillo</h3>
      <form action="/admin/menu/productos/crear" method="POST" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
        
        <div class="form-group" style="margin: 0;">
          <label style="font-size: 0.85rem; font-weight: 500;">Nombre del platillo:</label>
          <input type="text" name="nombre" placeholder="Ej. Hamburguesa Doble" required style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
        </div>

        <div class="form-group" style="margin: 0;">
          <label style="font-size: 0.85rem; font-weight: 500;">Precio ($):</label>
          <input type="number" step="0.01" name="precio" placeholder="120.00" required style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
        </div>

        <div class="form-group" style="margin: 0;">
          <label style="font-size: 0.85rem; font-weight: 500;">Stock inicial:</label>
          <input type="number" name="stock" value="15" required style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
        </div>

        <div class="form-group" style="margin: 0;">
          <label style="font-size: 0.85rem; font-weight: 500;">Categoría / Menú:</label>
          <select name="categoria_id" required style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box;">
            <option value="">Seleccione una categoría</option>
            <% if (categorias && categorias.length > 0) { %>
              <% categorias.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.nombre %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <div style="grid-column: 1 / -1; display: flex; justify-content: flex-end; margin-top: 10px;">
          <button type="submit" class="btn-sm btn-primary" style="padding: 10px 20px; cursor: pointer;">Guardar Platillo</button>
        </div>
      </form>
    </div>

  </div>
</body>
</html>