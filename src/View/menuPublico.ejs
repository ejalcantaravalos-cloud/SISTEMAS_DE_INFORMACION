<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Conoce los menús y platillos disponibles en nuestro restaurante.">
  <title>Menú del restaurante | Diversion y Eventos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --morado: #563576;
      --morado-oscuro: #34214a;
      --morado-suave: #efe8f5;
      --fondo: #faf9fc;
      --texto: #292335;
    }
    html { scroll-behavior: smooth; }
    body { background: var(--fondo); color: var(--texto); }
    .cabecera {
      background: linear-gradient(125deg, #34214a 0%, #63418a 100%);
      color: white;
    }
    .cabecera h1 { letter-spacing: -.03em; }
    .menu-navegacion {
      display: flex;
      gap: .65rem;
      overflow-x: auto;
      padding: .9rem 0 1.15rem;
      scrollbar-width: thin;
    }
    .enlace-menu {
      color: var(--morado);
      background: white;
      text-decoration: none;
      border: 1px solid #e0d6ec;
      border-radius: 999px;
      padding: .65rem 1.15rem;
      white-space: nowrap;
      font-weight: 600;
      transition: background .15s, color .15s;
    }
    .enlace-menu:hover, .enlace-menu:focus {
      color: white;
      background: var(--morado);
      border-color: var(--morado);
    }
    .seccion-menu { scroll-margin-top: 1rem; padding-top: 2.5rem; }
    .titulo-menu { color: var(--morado-oscuro); font-weight: 750; }
    .descripcion-menu { max-width: 65ch; }
    .contador { color: var(--morado); background: var(--morado-suave); border-radius: 999px; font-size: .8rem; padding: .35rem .75rem; }
    .platillo {
      border: 1px solid #e7e1ec;
      border-radius: 1rem;
      overflow: hidden;
      height: 100%;
      box-shadow: 0 5px 16px rgba(41, 29, 54, .04);
      transition: transform .15s, box-shadow .15s;
    }
    .platillo:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(41, 29, 54, .09); }
    .foto { height: 190px; width: 100%; object-fit: cover; background: var(--morado-suave); }
    .etiqueta-categoria { color: var(--morado); background: var(--morado-suave); padding: .3rem .6rem; border-radius: .4rem; font-size: .78rem; }
    .precio { color: var(--morado); font-size: 1.15rem; font-weight: 750; }
    .nombre-platillo { color: var(--morado-oscuro); }
    .descripcion-platillo { min-height: 2.8em; }
    .favorito { color: #855800; background: #fff0c3; border-radius: .4rem; font-size: .75rem; padding: .3rem .5rem; }
    .pie { border-top: 1px solid #e7e1ec; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .platillo, .enlace-menu { transition: none; } }
  </style>
</head>
<body>
  <header class="cabecera py-4 py-md-5">
    <div class="container">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
          <p class="text-uppercase small fw-semibold mb-2" style="letter-spacing:.13em;opacity:.85">Diversion y Eventos · Restaurante</p>
          <h1 class="display-6 fw-bold mb-2">Nuestros menús</h1>
          <p class="mb-0 opacity-75">Descubre los platillos que tenemos para ti.</p>
        </div>
        <a href="/" class="btn btn-outline-light btn-sm">← Volver al inicio</a>
      </div>
    </div>
  </header>

  <main class="container pb-5">
    <% if (!menus || menus.length === 0) { %>
      <div class="alert alert-info mt-4" role="status">
        Por el momento no hay platillos publicados en menús activos y vigentes.
      </div>
    <% } else { %>
      <nav aria-label="Ir a un menú" class="menu-navegacion mt-3">
        <% menus.forEach(menu => { %>
          <a class="enlace-menu" href="#menu-<%= menu.id %>"><%= menu.nombre %></a>
        <% }) %>
      </nav>

      <% menus.forEach(menu => { %>
        <section id="menu-<%= menu.id %>" class="seccion-menu" aria-labelledby="titulo-menu-<%= menu.id %>">
          <div class="mb-4">
            <div class="d-flex align-items-center flex-wrap gap-3 mb-2">
              <h2 id="titulo-menu-<%= menu.id %>" class="titulo-menu h3 mb-0"><%= menu.nombre %></h2>
              <span class="contador"><%= menu.productos.length %> <%= menu.productos.length === 1 ? 'platillo' : 'platillos' %></span>
            </div>
            <% if (menu.descripcion) { %>
              <p class="text-secondary descripcion-menu mb-0"><%= menu.descripcion %></p>
            <% } %>
          </div>

          <div class="row g-3 g-lg-4">
            <% menu.productos.forEach(p => { %>
              <div class="col-sm-6 col-lg-4 col-xl-3">
                <article class="card platillo">
                  <% if (p.imagen_url) { %>
                    <img src="<%= p.imagen_url %>" class="foto" alt="<%= p.nombre %>" loading="lazy">
                  <% } else { %>
                    <div class="foto d-flex justify-content-center align-items-center fs-1" aria-hidden="true">🍽️</div>
                  <% } %>
                  <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                      <span class="etiqueta-categoria"><%= p.categoria_nombre || 'Platillo' %></span>
                      <% if (p.favorito) { %>
                        <span class="favorito">★ Favorito</span>
                      <% } %>
                    </div>
                    <h3 class="h5 nombre-platillo mt-1"><%= p.nombre %></h3>
                    <p class="descripcion-platillo text-secondary small flex-grow-1"><%= p.descripcion || 'Preparado al momento.' %></p>
                    <div class="border-top pt-3 mt-auto">
                      <span class="precio">$<%= Number(p.precio_base).toFixed(2) %></span>
                    </div>
                  </div>
                </article>
              </div>
            <% }) %>
          </div>
        </section>
      <% }) %>
    <% } %>
  </main>

  <footer class="pie py-4 text-center text-secondary small">
    Helping Bee · Menú sujeto a disponibilidad.
  </footer>
</body>
</html>
