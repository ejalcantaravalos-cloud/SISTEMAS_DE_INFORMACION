<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Catálogo de Brincolines e Inflables</title>
  <!-- Bootstrap 5 CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      color: #334155;
    }
    .hero-section {
      background: linear-gradient(135deg, #0d6efd, #0dcaf0);
      color: white;
      border-radius: 12px;
    }
    .card-inflable {
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      background: #ffffff;
    }
    .card-inflable:hover {
      transform: translateY(-4px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.08);
    }
    .card-img-top {
      height: 220px;
      object-fit: cover;
      border-top-left-radius: 10px;
      border-top-right-radius: 10px;
    }
    .badge-status {
      font-size: 0.85rem;
      padding: 0.4em 0.8em;
    }
  </style>
</head>
<body>

  <div class="container py-5">

    <div class="hero-section p-5 mb-5 shadow-sm text-center">
      <h1 class="fw-bold display-5 mb-2"> Catálogo de Juegos Inflables</h1>
      <p class="lead mb-0">Explora nuestros equipos, consulta las medidas de espacio y elige el ideal para tu evento.</p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h4 class="fw-bold mb-0">Equipos Disponibles</h4>
      <a href="/admin/inflables" class="btn btn-outline-secondary btn-sm"> Ir al Panel de Administración</a>
    </div>

   
    <div class="row g-4">
      <% if (inflables && inflables.length > 0) { %>
        <% inflables.forEach(inf => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card card-inflable h-100 shadow-sm">
            
              <% if (inf.fotografia_url) { %>
                <img src="<%= inf.fotografia_url %>" alt="<%= inf.nombre %>" class="card-img-top">
              <% } else { %>
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center card-img-top">
                  <span>Sin Fotografía</span>
                </div>
              <% } %>

              <div class="card-body d-flex flex-column">
                <h5 class="card-title fw-bold text-dark mb-2"><%= inf.nombre %></h5>
                
                <p class="card-text text-muted small mb-3">
                  <strong>Espacio requerido:</strong> <%= inf.medidas_espacio %>
                </p>

                <div class="mt-auto d-flex justify-content-between align-items-center">
               
                  <% 
                    let badgeClass = 'bg-success';
                    let estadoTexto = inf.estado_disponibilidad;
                    if (inf.estado_disponibilidad === 'rentado') {
                      badgeClass = 'bg-danger';
                      estadoTexto = 'Rentado';
                    } else if (inf.estado_disponibilidad === 'requiere limpieza' || inf.estado_disponibilidad === 'mantenimiento') {
                      badgeClass = 'bg-warning text-dark';
                    }
                  %>
                  <span class="badge badge-status <%= badgeClass %>"><%= estadoTexto %></span>

              
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-info text-center py-4 shadow-sm">
            <h5>Por el momento no hay inflables registrados en el catálogo.</h5>
            <p class="mb-0 text-muted">Agrega algunos desde tu panel de administración.</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>

</body>
</html>