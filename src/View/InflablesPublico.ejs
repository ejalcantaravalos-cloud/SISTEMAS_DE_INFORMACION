
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Catálogo de Inflables</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >
<link rel="stylesheet" href="/css/InflablesPublico.css">
</head>

<body>

    <!-- Barra de navegación -->
    <nav class="navbar navbar-dark">
        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-stars me-2"></i>
                Diversión & Eventos
            </a>

            <a href="/" class="btn btn-outline-light btn-sm">
                <i class="bi bi-house"></i>
                Inicio
            </a>

        </div>
    </nav>


    <!-- Presentación -->
    <header class="hero">
        <div class="container">

            <h1 class="display-5">
                Nuestros Juegos Inflables
            </h1>

            <p class="lead mt-3">
                Descubre nuestros brincolines y encuentra
                la diversión ideal para tu celebración.
            </p>

        </div>
    </header>


    <!-- Catálogo -->
    <main class="container py-5">

        <div class="text-center mb-5">
            <h2 class="fw-bold">
                Catálogo de Brincolines
            </h2>

            <p class="text-muted">
                Consulta las características de nuestros equipos.
            </p>
        </div>

        <div class="row g-4">

            <% if (inflables && inflables.length > 0) { %>

                <% inflables.forEach(inf => { %>

                    <div class="col-md-6 col-lg-4">

                        <div class="card card-inflable h-100">

                            <!-- Fotografía -->
                            <div class="imagen-contenedor">

                                <img
                                    id="imagen-inflable-<%= inf.id_inflable %>"
                                    class="imagen-inflable"
                                    data-titulo="inflable-<%= inf.id_inflable %>"
                                    alt="<%= inf.nombre %>"
                                    hidden
                                >

                                <span class="text-muted small">
                                    Sin fotografía
                                </span>

                            </div>

                            <!-- Información -->
                            <div class="card-body d-flex flex-column">

                                <h4 class="card-title">
                                    <%= inf.nombre %>
                                </h4>

                                <p class="medidas mb-3">
                                    <i class="bi bi-rulers me-2"></i>
                                    Medidas del espacio:
                                    <strong>
                                        <%= inf.medidas_espacio %>
                                    </strong>
                                </p>

                                <!-- Disponibilidad -->
                                <div class="mt-auto">

                                    <% if (inf.estado_disponibilidad === 'disponible') { %>

                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Disponible
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">
                                            No disponible por el momento
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <div class="col-12 text-center py-5">

                    <i class="bi bi-info-circle display-4 text-muted"></i>

                    <h4 class="mt-3">
                        No hay juegos inflables registrados
                    </h4>

                    <p class="text-muted">
                        Próximamente podrás consultar nuestro catálogo.
                    </p>

                </div>

            <% } %>

        </div>

        <!-- Regresar -->
        <div class="text-center mt-5">

            <a href="/" class="btn btn-volver">
                <i class="bi bi-arrow-left me-2"></i>
                Volver al Inicio
            </a>

        </div>

    </main>


    <!-- Pie de página -->
    <footer class="text-center">

        <h5 class="fw-bold">
            Diversión & Eventos
        </h5>

        <p class="mb-0">
            Diversión para toda la familia.
        </p>

    </footer>


    <!-- Cargar imágenes desde Cloudinary -->
    <script src="/js/loader_imagenes.js"></script>

</body>
</html>
