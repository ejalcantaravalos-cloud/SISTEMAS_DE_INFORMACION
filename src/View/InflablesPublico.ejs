
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Catálogo de Inflables | Diversión & Eventos</title>

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <!-- Tu CSS personalizado -->
    <link
        rel="stylesheet"
        href="/css/InflablesPublico.css"
    >

    <style>
        /* Ajustes específicos del catálogo */

        .card-inflable {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, .08);
            transition: transform .2s ease;
        }

        .card-inflable:hover {
            transform: translateY(-4px);
        }

        .imagen-contenedor {
            width: 100%;
            height: 235px;
            overflow: hidden;
            background: #f0ecf8;
        }

        .catalogo-foto {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .sin-fotografia {
            display: flex;
            height: 100%;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 10px;
            color: #777;
        }

        .sin-fotografia i {
            font-size: 3rem;
        }

        .nombre-inflable {
            font-weight: 700;
            color: #303046;
        }

        .precio-inflable {
            font-size: 1.3rem;
            font-weight: 750;
            color: #7546c8;
        }

        .seccion-detalle {
            background: #f8f6fc;
            border-radius: 12px;
            padding: 15px;
        }

        .titulo-detalle {
            font-size: .9rem;
            font-weight: 700;
            color: #5f418f;
            margin-bottom: 8px;
        }

        .requisitos-texto {
            white-space: pre-line;
            overflow-wrap: anywhere;
            font-size: .92rem;
            color: #555;
        }

        .aviso-disponibilidad {
            font-size: .88rem;
            color: #686078;
        }
    </style>

</head>

<body>

    <!-- =====================================
         BARRA DE NAVEGACIÓN
    ====================================== -->

    <nav class="navbar navbar-dark"
         style="background-color: #9062db;">

        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-stars me-2"></i>
                Diversión & Eventos
            </a>

            <a href="/"
               class="btn btn-outline-light btn-sm">

                <i class="bi bi-house me-1"></i>
                Inicio

            </a>

        </div>

    </nav>


    <!-- =====================================
         PRESENTACIÓN
    ====================================== -->

    <header class="hero">

        <div class="container">

            <h1 class="display-5 fw-bold">
                Nuestros Juegos Inflables
            </h1>

            <p class="lead mt-3">
                Descubre nuestros brincolines
                y encuentra la diversión ideal
                para tu celebración.
            </p>

        </div>

    </header>


    <!-- =====================================
         CATÁLOGO
    ====================================== -->

    <main class="container py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Catálogo de Brincolines
            </h2>

            <p class="text-muted">
                Consulta las medidas, características
                y requisitos de instalación
                de nuestros equipos.
            </p>

        </div>


        <div class="row g-4">

            <% if (inflables && inflables.length > 0) { %>

                <% inflables.forEach(inf => { %>

                    <%
                        // Campos actuales de la base de datos
                        const largo = inf.largo_m;
                        const ancho = inf.ancho_m;
                        const alto = inf.alto_m;

                        // Compatibilidad con el nombre anterior
                        // y el nuevo nombre del precio.
                        const precio =
                            inf.precio_completo ??
                            inf.tarifa_base;

                        const tienePrecio =
                            precio != null &&
                            Number.isFinite(Number(precio));

                        const formatoMedida = (valor) => {
                            if (
                                valor == null ||
                                !Number.isFinite(Number(valor))
                            ) {
                                return 'Por confirmar';
                            }

                            return Number(valor).toLocaleString(
                                'es-MX',
                                { maximumFractionDigits: 2 }
                            ) + ' m';
                        };

                        const requisitos =
                            inf.requisitos_instalacion ||
                            'Consultar los requisitos de instalación.';
                    %>

                    <div class="col-md-6 col-lg-4">

                        <article class="card card-inflable h-100">

                            <!-- ==========================
                                 FOTOGRAFÍA
                            =========================== -->

                            <div class="imagen-contenedor">

                                <% if (inf.imagen) { %>

                                    <img
                                        src="<%= inf.imagen %>"
                                        class="catalogo-foto"
                                        alt="Fotografía de <%= inf.nombre %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <div class="sin-fotografia">

                                        <i class="bi bi-image"></i>

                                        <span>
                                            Sin fotografía disponible
                                        </span>

                                    </div>

                                <% } %>

                            </div>


                            <!-- ==========================
                                 INFORMACIÓN
                            =========================== -->

                            <div class="card-body d-flex flex-column gap-3">

                                <!-- NOMBRE -->

                                <h3 class="h4 nombre-inflable mb-0">
                                    <%= inf.nombre %>
                                </h3>


                                <!-- PRECIO -->

                                <% if (tienePrecio) { %>

                                    <div>

                                        <div class="small text-muted">
                                            Precio de renta
                                        </div>

                                        <div class="precio-inflable">

                                            <%= Number(precio).toLocaleString(
                                                'es-MX',
                                                {
                                                    style: 'currency',
                                                    currency: 'MXN'
                                                }
                                            ) %>

                                        </div>

                                    </div>

                                <% } %>


                                <!-- ==========================
                                     MEDIDAS
                                =========================== -->

                                <div class="seccion-detalle">

                                    <div class="titulo-detalle">

                                        <i class="bi bi-rulers me-2"></i>

                                        Dimensiones del inflable

                                    </div>

                                    <div class="row g-2 small">

                                        <div class="col-4">

                                            <span class="text-muted">
                                                Largo
                                            </span>

                                            <div class="fw-semibold">
                                                <%= formatoMedida(largo) %>
                                            </div>

                                        </div>

                                        <div class="col-4">

                                            <span class="text-muted">
                                                Ancho
                                            </span>

                                            <div class="fw-semibold">
                                                <%= formatoMedida(ancho) %>
                                            </div>

                                        </div>

                                        <div class="col-4">

                                            <span class="text-muted">
                                                Alto
                                            </span>

                                            <div class="fw-semibold">
                                                <%= formatoMedida(alto) %>
                                            </div>

                                        </div>

                                    </div>

                                </div>


                                <!-- ==========================
                                     REQUISITOS
                                =========================== -->

                                <div class="seccion-detalle">

                                    <div class="titulo-detalle">

                                        <i class="bi bi-clipboard-check me-2"></i>

                                        Requisitos de instalación

                                    </div>

                                    <div class="requisitos-texto">
                                        <%= requisitos %>
                                    </div>

                                </div>


                                <!-- ==========================
                                     DISPONIBILIDAD
                                =========================== -->

                                <div class="mt-auto pt-2">

                                    <div class="aviso-disponibilidad">

                                        <i class="bi bi-calendar-event me-2"></i>

                                        Disponibilidad sujeta
                                        a la fecha solicitada.

                                    </div>

                                </div>

                            </div>

                        </article>

                    </div>

                <% }); %>

            <% } else { %>

                <!-- ==========================
                     CATÁLOGO VACÍO
                =========================== -->

                <div class="col-12 text-center py-5">

                    <i class="bi bi-info-circle display-4 text-muted"></i>

                    <h4 class="mt-3">
                        No hay juegos inflables registrados
                    </h4>

                    <p class="text-muted">
                        Próximamente podrás consultar
                        nuestro catálogo.
                    </p>

                </div>

            <% } %>

        </div>


        <!-- ==================================
             VOLVER AL INICIO
        =================================== -->

        <div class="text-center mt-5">

            <a href="/"
               class="btn btn-volver">

                <i class="bi bi-arrow-left me-2"></i>
                Volver al Inicio

            </a>

        </div>

    </main>


    <!-- =====================================
         PIE DE PÁGINA
    ====================================== -->

    <footer class="text-center py-4">

        <h5 class="fw-bold">
            Diversión & Eventos
        </h5>

        <p class="mb-0">
            Diversión para toda la familia.
        </p>

    </footer>


    <!-- Bootstrap 5 JavaScript -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

</body>
</html>
