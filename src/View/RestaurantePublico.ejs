
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Menú del Restaurante</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >
    <link rel="stylesheet" href="/css/RestaurantePublico.css">
    
</head>

<body>

    <!-- Barra de navegación -->
    <nav class="navbar navbar-dark">
        <div class="container">

            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-stars me-2"></i>
                Diversión & Eventos
            </a>

            <a href="/" class="btn btn-outline-light btn-sm">
                <i class="bi bi-house"></i>
                Inicio
            </a>

        </div>
    </nav>


    <!-- Presentación -->
    <header class="hero">
        <div class="container">

            <h1 class="display-5">
                Nuestro Restaurante
            </h1>

            <p class="lead mt-3">
                ¡Descubre los sabores que tenemos para ti!
            </p>

            <p>
                Disfruta de nuestro menú de comida rápida,
                preparado para compartir momentos deliciosos
                con toda la familia.
            </p>

        </div>
    </header>


    <!-- Catálogo de platillos -->
    <main class="container py-5">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Nuestro Menú
            </h2>

            <p class="text-muted">
                Conoce nuestros platillos y sus precios.
            </p>

        </div>


        <div class="row g-4">

            <% if (productos && productos.length > 0) { %>

                <% productos.forEach(p => { %>

                    <div class="col-md-6 col-lg-4">

                        <div class="card card-platillo h-100">

                         
<!-- Imagen del platillo -->
<div class="imagen-contenedor">
    <img
        id="imagen-platillo-<%= p.id %>"
        class="imagen-platillo"
        data-titulo="platillo-<%= p.id %>"
        data-titulo-alternativo="<%= p.nombre %>"
        alt="<%= p.nombre %>"
        hidden
    >

    <span class="text-muted small">
        Sin fotografía
    </span>
</div>



                            <!-- Información -->
                            <div class="card-body d-flex flex-column">

                                <!-- Categoría -->
                                <p class="categoria mb-2">

                                    <i class="bi bi-tag me-1"></i>

                                    <%= p.categoria_nombre || 'Menú General' %>

                                </p>


                                <!-- Nombre -->
                                <h4 class="nombre-platillo mb-3">
                                    <%= p.nombre %>
                                </h4>


                                <!-- Platillo especial -->
                                <% if (p.especial) { %>

                                    <div class="mb-3">
                                        <span class="badge-especial">
                                            ⭐ Platillo Especial
                                        </span>
                                    </div>

                                <% } %>


                                <!-- Precio -->
                                <div class="mt-auto">

                                    <p class="precio mb-2">
                                        $<%= Number(p.precio).toFixed(2) %>
                                    </p>

                                    <!-- Disponibilidad -->
                                    <% if (Number(p.stock) > 0) { %>

                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i>
                                            Disponible
                                        </span>

                                    <% } else { %>

                                        <span class="badge bg-secondary">
                                            Agotado por el momento
                                        </span>

                                    <% } %>

                                </div>

                            </div>

                        </div>

                    </div>

                <% }) %>

            <% } else { %>

                <!-- Sin productos -->
                <div class="col-12 text-center py-5">

                    <i class="bi bi-cup-hot display-4 text-muted"></i>

                    <h4 class="mt-3">
                        No hay platillos disponibles
                    </h4>

                    <p class="text-muted">
                        Próximamente podrás consultar
                        nuestro menú.
                    </p>

                </div>

            <% } %>

        </div>


        <!-- Botón regresar -->
        <div class="text-center mt-5">

            <a href="/" class="btn btn-volver">
                <i class="bi bi-arrow-left me-2"></i>
                Volver al Inicio
            </a>

        </div>

    </main>


    <!-- Pie de página -->
    <footer class="text-center">

        <h5 class="fw-bold">
            Diversión & Eventos
        </h5>

        <p class="mb-0">
            Celebraciones, diversión y buena comida
            en un solo lugar.
        </p>

    </footer>


    <!-- Cargar fotografías -->
    <script src="/js/loader_imagenes.js"></script>

</body>
</html>
