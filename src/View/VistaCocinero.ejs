<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cocina | Seguimiento de comandas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root { --morado:#453581; --oscuro:#272044; --fondo:#f7f6fb; }
        body { background:var(--fondo); color:#26314b; }
        .cabecera { background:linear-gradient(125deg,#302458,#6753a5); border-radius:20px; color:#fff; padding:25px 30px; }
        .cabecera .detalle { color:#e6e0fc; }
        .estadistica { background:#fff; border:1px solid #eae7f5; border-radius:15px; padding:18px; height:100%; }
        .estadistica .numero { font-size:2rem; font-weight:800; line-height:1.1; }
        .seccion-titulo { font-size:1.1rem; font-weight:750; }
        .comanda { border:1px solid #e3dfef; border-radius:17px; overflow:hidden; box-shadow:0 6px 20px rgba(42,35,80,.05); }
        .comanda.activa { border-top:5px solid #efad35; }
        .comanda.terminada { border-top:5px solid #52ae84; }
        .comanda .card-header { background:#fff; border-bottom:1px solid #f0edf6; padding:18px 20px; }
        .comanda .card-body { padding:20px; }
        .pedido-numero { color:var(--morado); font-size:1.35rem; font-weight:800; }
        .etiqueta { border-radius:20px; padding:.35rem .65rem; font-weight:650; font-size:.79rem; }
        .etiqueta-prep { background:#fff1d1; color:#875209; }
        .etiqueta-listo { background:#dff6e9; color:#125c3c; }
        .platillo { border-bottom:1px dashed #dedbe9; padding:13px 0; }
        .platillo:last-child { border-bottom:0; }
        .modificaciones { margin:9px 0 0; padding:0; list-style:none; }
        .modificaciones li { font-size:.88rem; padding:3px 0; overflow-wrap:anywhere; }
        .quitar { color:#a02842; font-weight:600; }
        .extra { color:#0a745a; font-weight:600; }
        .opcion { color:#554d83; }
        .nota { background:#fff7e7; border:1px solid #fae2ac; border-radius:10px; padding:10px 12px; white-space:pre-wrap; overflow-wrap:anywhere; }
        .nota-item { background:#f1eff9; border-color:#e1dcf4; }
        .btn-listo { background:#21805a; border:0; color:#fff; font-weight:700; border-radius:10px; }
        .btn-listo:hover { background:#166948; color:#fff; }
        .vacio { border:2px dashed #ded8ee; border-radius:16px; color:#6d668a; background:#fff; padding:40px 20px; text-align:center; }
        @media print { .no-imprimir { display:none!important; } body { background:#fff; } .comanda { break-inside:avoid; box-shadow:none; } }
    </style>
    <link rel="stylesheet" href="/css/Avisos.css">
</head>
<body>
<%
    const lista = Array.isArray(pedidos) ? pedidos : [];
    const pendientes = lista.filter(p => ['Enviado', 'Orden tomada'].includes(p.estado));
    const listos = lista.filter(p => p.estado === 'Listo para entregar');
%>
<main class="container-fluid px-3 px-lg-5 py-4">
    <header class="cabecera d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-semibold detalle mb-1">ZABAVA · Restaurante</div>
            <h1 class="h2 fw-bold mb-1">Panel de cocina</h1>
            <p class="detalle mb-0">Comandas pendientes, ingredientes y notas de preparación.</p>
        </div>
        <div class="d-flex gap-2 no-imprimir">
            <a class="btn btn-light btn-sm" href="/ordenes/cocina">Actualizar</a>
            <button class="btn btn-outline-light btn-sm" type="button" onclick="window.print()">Imprimir</button>
              <li class="btn btn-outline-warning"><a class="nav-link text-warning" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Salir</a></li>
        </div>
    </header>

    <section class="row g-3 mb-4" aria-label="Resumen de cocina">
        <div class="col-sm-4"><div class="estadistica"><div class="text-muted small">Enviadas</div><div class="numero text-primary"><%= pendientes.filter(p => p.estado === 'Enviado').length %></div></div></div>
        <div class="col-sm-4"><div class="estadistica"><div class="text-muted small">Órdenes tomadas</div><div class="numero text-warning-emphasis"><%= pendientes.filter(p => p.estado === 'Orden tomada').length %></div></div></div>
        <div class="col-sm-4"><div class="estadistica"><div class="text-muted small">Listos (pedidos de hoy)</div><div class="numero text-success"><%= listos.length %></div></div></div>
    </section>

    <section aria-labelledby="pendientesTitulo">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 id="pendientesTitulo" class="seccion-titulo mb-0">Comandas enviadas y tomadas</h2>
            <span class="etiqueta etiqueta-prep"><%= pendientes.length %> comanda(s)</span>
        </div>
        <% if (!pendientes.length) { %>
            <div class="vacio mb-4"><div class="h4 mb-2">✓ Cocina al día</div>No hay comandas pendientes por ahora.</div>
        <% } else { %>
            <div class="row g-3 mb-4">
                <% pendientes.forEach(p => { %>
                    <div class="col-lg-6 col-xxl-4">
                        <article class="card comanda activa h-100">
                            <div class="card-header d-flex align-items-start justify-content-between gap-2">
                                <div>
                                    <div class="pedido-numero">Comanda #<%= p.id %></div>
                                    <div class="small text-muted"><%= p.fecha_texto || 'Sin fecha' %></div>
                                </div>
                                <span class="etiqueta <%= p.estado === 'Enviado' ? 'text-bg-primary' : 'etiqueta-prep' %>"><%= p.estado %></span>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <div class="mb-3">
                                    <div><strong><%= p.numero_mesa ? 'Mesa ' + p.numero_mesa : p.tipo_texto %></strong></div>
                                    <div class="small"><strong>Cliente:</strong> <%= p.cliente_nombre %></div>
                                    <div class="small text-muted"><strong>Registró:</strong> <%= p.cajero_nombre %></div>
                                </div>
                                <h3 class="h6 fw-bold mb-1">Platillos solicitados</h3>
                                <% if (p.detalles.length === 0) { %><p class="text-muted small">Sin productos en esta comanda.</p><% } %>
                                <% p.detalles.forEach(d => { %>
                                    <div class="platillo">
                                        <div class="fw-semibold"><span class="badge text-bg-dark me-1"><%= d.cantidad %>×</span> <%= d.nombre %></div>
                                        <% if (d.modificaciones.length || d.opciones.length) { %>
                                            <ul class="modificaciones">
                                                <% d.modificaciones.forEach(m => { %>
                                                    <% if (m.accion === 'QUITADO') { %>
                                                        <li class="quitar">− Sin <%= m.nombre %></li>
                                                    <% } else if (m.accion === 'EXTRA') { %>
                                                        <li class="extra">+ <%= m.nombre %> extra × <%= m.porciones %></li>
                                                    <% } %>
                                                <% }) %>
                                                <% d.opciones.forEach(o => { %><li class="opcion">• <%= o.nombre %></li><% }) %>
                                            </ul>
                                        <% } else { %>
                                            <div class="text-muted small mt-1">Preparación estándar</div>
                                        <% } %>
                                        <% if (d.nota_cocina) { %><div class="nota nota-item small mt-2"><strong>Nota del platillo:</strong> <%= d.nota_cocina %></div><% } %>
                                    </div>
                                <% }) %>
                                <% if (p.nota) { %><div class="nota small mt-3"><strong>Nota general:</strong> <%= p.nota %></div><% } %>
                                <div class="mt-auto pt-3 no-imprimir">
                                    <% if (p.estado === 'Enviado') { %>
                                        <form action="/ordenes/cocina/<%= p.id %>/tomar" method="POST">
                                            <input type="hidden" name="version" value="<%= p.version %>">
                                            <button type="submit" class="btn btn-primary w-100 py-2">Tomar orden</button>
                                        </form>
                                    <% } else { %>
                                        <form action="/ordenes/cocina/<%= p.id %>/completar" method="POST" onsubmit="return confirm('¿Confirmas que la comanda #<%= p.id %> está lista?')">
                                            <button type="submit" class="btn btn-listo w-100 py-2">✓ Marcar como listo para entregar</button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </section>

    <section aria-labelledby="terminadosTitulo" class="mt-4">
        <h2 id="terminadosTitulo" class="seccion-titulo mb-3">Listos para entregar</h2>
        <% if (listos.length === 0) { %>
            <p class="text-muted small">Aún no hay pedidos completados de hoy.</p>
        <% } else { %>
            <div class="row g-3">
                <% listos.forEach(p => { %>
                    <div class="col-md-6 col-xl-4">
                        <article class="card comanda terminada h-100">
                            <div class="card-body d-flex justify-content-between gap-3 align-items-center">
                                <div>
                                    <div class="fw-bold">Comanda #<%= p.id %></div>
                                    <div class="small text-muted"><%= p.numero_mesa ? 'Mesa ' + p.numero_mesa : p.tipo_texto %> · <%= p.cliente_nombre %></div>
                                </div>
                                <span class="etiqueta etiqueta-listo">Lista</span>
                            </div>
                        </article>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </section>
    <p class="text-muted small mt-4 no-imprimir">Recarga la pantalla para ver nuevas comandas registradas en caja.</p>
</main>
<%- include('partials/Aviso') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
