
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Cobro de pedido</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet">
      <link rel="stylesheet" href="/css/Cobro.css">
    </div>
</head>

<body class="bg-light">
       <div>
    <a href="/ordenes/caja " class="btn btn-sm btn-outline-secondary">
        ← Volver al Panel
    </a>
</div>

<div class="container py-5">
    <div class="card shadow mx-auto"
         style="max-width: 650px;">

        <div class="card-header bg-success text-white">
            <h4 class="mb-0 text-center">
                Resumen de la orden
            </h4>
        </div>

        <div class="card-body p-4">

            <h5>Pedido #<%= orden.id %></h5>

            <p>
                <strong>Tipo:</strong>
                <%= orden.tipo_orden %>
            </p>

            <% if (orden.tipo_orden === 'Mesa') { %>
                <p>
                    <strong>Mesa:</strong>
                    <%= orden.numero_mesa %>
                </p>
            <% } %>

            <p>
                <strong>Cliente:</strong>
                <%= orden.nombre_cliente || 'Sin nombre' %>
            </p>

            <p>
                <strong>Estado de pago:</strong>

                <span class="badge <%= orden.estado_pago === 'Pagado'
                    ? 'bg-success'
                    : 'bg-warning text-dark' %>">
                    <%= orden.estado_pago %>
                </span>
            </p>

            <hr>

            <h6>Productos solicitados</h6>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    <% productos.forEach(p => { %>
                        <tr>
                            <td><%= p.nombre %></td>
                            <td><%= p.cantidad %></td>
                            <td>
                                $<%= (
                                    Number(p.precio) *
                                    Number(p.cantidad)
                                ).toFixed(2) %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <% if (orden.nota) { %>
                <p>
                    <strong>Notas:</strong>
                    <%= orden.nota %>
                </p>
            <% } %>

            <h3 class="text-end text-success">
                Total: $<%= Number(orden.total).toFixed(2) %>
            </h3>

            <hr>

            <% if (pagoActualizado) { %>
                <div class="alert alert-success">
                    Estado de pago actualizado correctamente.
                </div>
            <% } %>

            <h5 class="text-center mb-3">
                ¿El cliente ha pagado?
            </h5>

            <form
              action="/ordenes/cobro/<%= orden.id %>/estado-pago"
              method="POST">

                <div class="row g-2">

                    <div class="col-6">
                        <button
                          type="submit"
                          name="estado_pago"
                          value="Pagado"
                          class="btn btn-success w-100 py-3">
                            ✓ Pagado
                        </button>
                    </div>

                    <div class="col-6">
                        <button
                          type="submit"
                          name="estado_pago"
                          value="No pagado"
                          class="btn btn-danger w-100 py-3">
                            ✕ No pagado
                        </button>
                    </div>

                </div>
                <div class="mt-3 no-imprimir">
    <button
        type="button"
        class="btn btn-outline-dark w-100 py-2"
        onclick="window.print()">
        Imprimir ticket
    </button>
</div>
            </form>

        </div>
    </div>
</div>

</span>



</body>
</html>
