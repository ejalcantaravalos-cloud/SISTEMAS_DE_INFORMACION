
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Administración de Inflables | HelpingBee</title>

    <!-- BOOTSTRAP 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f5f7fb;
        }

        .card-panel {
            border: 1px solid #e4e8ef;
            border-radius: 14px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04);
        }

        .img-thumb {
            width: 85px;
            height: 75px;
            object-fit: cover;
            border-radius: 10px;
        }

        .sin-imagen {
            width: 85px;
            height: 75px;
            background: #eef0f4;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            font-size: 12px;
            text-align: center;
        }

        .imagen-edicion {
            width: 150px;
            height: 110px;
            object-fit: cover;
            border-radius: 10px;
        }

        .form-label {
            font-weight: 500;
        }
    </style>
</head>

<body>

<div class="container-fluid px-3 px-lg-4 py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Catálogo de Brincolines e Inflables
            </h2>

            <p class="text-muted mb-0">
                Administración y control de equipos de renta
            </p>
        </div>

        <a href="/admin"
           class="btn btn-outline-secondary">
            ← Volver al Panel
        </a>
    </div>


    <!-- MENSAJES -->
    <% if (typeof aviso !== 'undefined' && aviso) { %>
        <div class="alert alert-info alert-dismissible fade show"
             role="alert">

            <%= aviso %>

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar"
            ></button>
        </div>
    <% } %>


    <div class="row g-4">

        <!-- COLUMNA IZQUIERDA -->
        <div class="col-lg-4 col-xl-3">

            <!-- REGISTRAR INFLABLE -->
            <div class="card card-panel bg-white">

                <div class="card-body p-3 p-md-4">

                    <h5 class="fw-bold mb-3">
                        Registrar Nuevo Inflable
                    </h5>

                    <form
                        action="/admin/inflables/crear"
                        method="POST"
                        enctype="multipart/form-data"
                    >

                        <!-- NOMBRE -->
                        <div class="mb-3">
                            <label for="nombreCrear"
                                   class="form-label">
                                Nombre del Inflable
                            </label>

                            <input
                                type="text"
                                id="nombreCrear"
                                name="nombre"
                                class="form-control"
                                placeholder="Ej. Castillo Gigante"
                                maxlength="120"
                                required
                            >
                        </div>


                        <!-- DIMENSIONES -->
                        <label class="form-label">
                            Dimensiones (metros)
                        </label>

                        <div class="row g-2 mb-3">

                            <div class="col-4">
                                <label for="largoCrear"
                                       class="form-label small">
                                    Largo
                                </label>

                                <input
                                    type="number"
                                    id="largoCrear"
                                    name="largo_m"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="5"
                                >
                            </div>

                            <div class="col-4">
                                <label for="anchoCrear"
                                       class="form-label small">
                                    Ancho
                                </label>

                                <input
                                    type="number"
                                    id="anchoCrear"
                                    name="ancho_m"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="5"
                                >
                            </div>

                            <div class="col-4">
                                <label for="altoCrear"
                                       class="form-label small">
                                    Alto
                                </label>

                                <input
                                    type="number"
                                    id="altoCrear"
                                    name="alto_m"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="3"
                                >
                            </div>
                        </div>


                        <!-- REQUISITOS -->
                        <div class="mb-3">
                            <label for="requisitosCrear"
                                   class="form-label">
                                Requisitos de Instalación
                            </label>

                            <textarea
                                id="requisitosCrear"
                                name="requisitos_instalacion"
                                class="form-control"
                                rows="3"
                                placeholder="Ej. Superficie plana, conexión eléctrica..."
                            ></textarea>
                        </div>


                        <!-- PRECIO COMPLETO -->
                        <div class="mb-3">
                            <label for="precioCrear"
                                   class="form-label">
                                Precio Completo de Renta ($)
                            </label>

                            <input
                                type="number"
                                id="precioCrear"
                                name="precio_completo"
                                class="form-control"
                                min="0"
                                step="0.01"
                                placeholder="Ej. 1500.00"
                                required
                            >

                            <div class="form-text">
                                Incluye la instalación del inflable.
                            </div>
                        </div>


                        <!-- FOTOGRAFÍA -->
                        <div class="mb-3">
                            <label for="imagenCrear"
                                   class="form-label">
                                Fotografía de Portada
                            </label>

                            <input
                                type="file"
                                id="imagenCrear"
                                name="imagen"
                                class="form-control"
                                accept="image/jpeg,image/png,image/webp"
                            >

                            <div class="form-text">
                                JPG, PNG o WebP. Máximo 5 MB.
                            </div>
                        </div>


                        <!-- DESCRIPCIÓN DE IMAGEN -->
                        <div class="mb-3">
                            <label for="descripcionCrear"
                                   class="form-label">
                                Descripción de la Fotografía
                            </label>

                            <input
                                type="text"
                                id="descripcionCrear"
                                name="descripcion_imagen"
                                class="form-control"
                                maxlength="255"
                                placeholder="Ej. Vista frontal del inflable"
                            >
                        </div>


                        <button
                            type="submit"
                            class="btn btn-primary w-100"
                        >
                            Guardar Inflable
                        </button>

                    </form>
                </div>
            </div>



            <!-- EDITAR INFLABLE -->
            <div
                class="card card-panel bg-white mt-4 d-none"
                id="panelEditarInflable"
            >

                <div class="card-body p-3 p-md-4">

                    <h5 class="fw-bold mb-3">
                        Editar Inflable
                    </h5>

                    <form
                        id="formEditarInflable"
                        method="POST"
                        enctype="multipart/form-data"
                    >

                        <!-- NOMBRE -->
                        <div class="mb-3">
                            <label for="nombreEditar"
                                   class="form-label">
                                Nombre del Inflable
                            </label>

                            <input
                                type="text"
                                id="nombreEditar"
                                name="nombre"
                                class="form-control"
                                maxlength="120"
                                required
                            >
                        </div>


                        <!-- DIMENSIONES -->
                        <label class="form-label">
                            Dimensiones (metros)
                        </label>

                        <div class="row g-2 mb-3">

                            <div class="col-4">
                                <label for="largoEditar"
                                       class="form-label small">
                                    Largo
                                </label>

                                <input
                                    type="number"
                                    id="largoEditar"
                                    name="largo_m"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                >
                            </div>

                            <div class="col-4">
                                <label for="anchoEditar"
                                       class="form-label small">
                                    Ancho
                                </label>

                                <input
                                    type="number"
                                    id="anchoEditar"
                                    name="ancho_m"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                >
                            </div>

                            <div class="col-4">
                                <label for="altoEditar"
                                       class="form-label small">
                                    Alto
                                </label>

                                <input
                                    type="number"
                                    id="altoEditar"
                                    name="alto_m"
                                    class="form-control"
                                    min="0.01"
                                    step="0.01"
                                >
                            </div>
                        </div>


                        <!-- REQUISITOS -->
                        <div class="mb-3">
                            <label for="requisitosEditar"
                                   class="form-label">
                                Requisitos de Instalación
                            </label>

                            <textarea
                                id="requisitosEditar"
                                name="requisitos_instalacion"
                                class="form-control"
                                rows="3"
                            ></textarea>
                        </div>


                        <!-- PRECIO -->
                        <div class="mb-3">
                            <label for="precioEditar"
                                   class="form-label">
                                Precio Completo de Renta ($)
                            </label>

                            <input
                                type="number"
                                id="precioEditar"
                                name="precio_completo"
                                class="form-control"
                                min="0"
                                step="0.01"
                                required
                            >
                        </div>


                        <!-- FOTOGRAFÍA ACTUAL -->
                        <div class="mb-3">
                            <label class="form-label">
                                Fotografía Actual
                            </label>

                            <div>
                                <img
                                    id="imagenActualEditar"
                                    class="imagen-edicion d-none"
                                    alt="Fotografía del inflable"
                                >

                                <p
                                    id="textoSinImagen"
                                    class="text-muted small mb-0"
                                >
                                    Sin fotografía registrada.
                                </p>
                            </div>
                        </div>


                        <!-- NUEVA FOTOGRAFÍA -->
                        <div class="mb-3">
                            <label for="imagenEditar"
                                   class="form-label">
                                Cambiar Fotografía
                            </label>

                            <input
                                type="file"
                                id="imagenEditar"
                                name="imagen"
                                class="form-control"
                                accept="image/jpeg,image/png,image/webp"
                            >

                            <div class="form-text">
                                Déjalo vacío para conservar la foto actual.
                            </div>
                        </div>


                        <!-- DESCRIPCIÓN -->
                        <div class="mb-3">
                            <label for="descripcionEditar"
                                   class="form-label">
                                Descripción de la Nueva Fotografía
                            </label>

                            <input
                                type="text"
                                id="descripcionEditar"
                                name="descripcion_imagen"
                                class="form-control"
                                maxlength="255"
                            >
                        </div>


                        <!-- BOTONES -->
                        <div class="d-flex gap-2">

                            <button
                                type="submit"
                                class="btn btn-primary flex-fill"
                            >
                                Guardar Cambios
                            </button>

                            <button
                                type="button"
                                id="btnCancelarEdicion"
                                class="btn btn-outline-secondary"
                            >
                                Cancelar
                            </button>

                        </div>
                    </form>

                </div>
            </div>

        </div>



        <!-- COLUMNA DERECHA -->
        <div class="col-lg-8 col-xl-9">

            <div class="card card-panel bg-white">

                <!-- ENCABEZADO DE TABLA -->
                <div class="card-header bg-white py-3">

                    <div class="d-flex align-items-center gap-2">

                        <h5 class="fw-bold mb-0">
                            Inflables Registrados
                        </h5>

                        <span class="badge bg-primary">
                            <%= inflables ? inflables.length : 0 %>
                        </span>

                    </div>
                </div>


                <div class="card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Foto</th>
                                    <th>Inflable</th>
                                    <th>Dimensiones</th>
                                    <th>Precio Completo</th>
                                    <th>Estado</th>
                                    <th class="text-end pe-3">
                                        Acciones
                                    </th>
                                </tr>
                            </thead>


                            <tbody>

                                <% if (inflables && inflables.length > 0) { %>

                                    <% inflables.forEach(inf => { %>

                                        <tr>

                                            <!-- FOTOGRAFÍA -->
                                            <td class="ps-3">

                                                <% if (inf.imagen) { %>

                                                    <img
                                                        src="<%= inf.imagen %>"
                                                        alt="<%= inf.nombre %>"
                                                        class="img-thumb"
                                                        loading="lazy"
                                                    >

                                                <% } else { %>

                                                    <div class="sin-imagen">
                                                        Sin foto
                                                    </div>

                                                <% } %>

                                            </td>


                                            <!-- INFORMACIÓN -->
                                            <td>

                                                <div class="fw-bold">
                                                    <%= inf.nombre %>
                                                </div>

                                                <small class="text-muted">
                                                    ID: <%= inf.id %>
                                                </small>

                                                <% if (inf.requisitos_instalacion) { %>

                                                    <p class="small text-muted mt-2 mb-0">
                                                        <%= inf.requisitos_instalacion %>
                                                    </p>

                                                <% } %>

                                            </td>


                                            <!-- DIMENSIONES -->
                                            <td class="small">

                                                <div>
                                                    Largo:
                                                    <%= inf.largo_m ?? '—' %> m
                                                </div>

                                                <div>
                                                    Ancho:
                                                    <%= inf.ancho_m ?? '—' %> m
                                                </div>

                                                <div>
                                                    Alto:
                                                    <%= inf.alto_m ?? '—' %> m
                                                </div>

                                            </td>


                                            <!-- PRECIO COMPLETO -->
                                            <td class="fw-semibold">

                                                <%= Number(inf.precio_completo).toLocaleString(
                                                    'es-MX',
                                                    {
                                                        style: 'currency',
                                                        currency: 'MXN'
                                                    }
                                                ) %>

                                            </td>


                                            <!-- ESTADO DEL CATÁLOGO -->
                                            <td>

                                                <% if (Number(inf.activo) === 1) { %>

                                                    <span class="badge bg-success mb-2">
                                                        Habilitado
                                                    </span>

                                                <% } else { %>

                                                    <span class="badge bg-secondary mb-2">
                                                        Deshabilitado
                                                    </span>

                                                <% } %>


                                                <!-- CAMBIAR HABILITACIÓN -->
                                                <form
                                                    action="/admin/inflables/estado/<%= inf.id %>"
                                                    method="POST"
                                                >

                                                    <input
                                                        type="hidden"
                                                        name="activo"
                                                        value="<%= Number(inf.activo) === 1 ? 0 : 1 %>"
                                                    >

                                                    <button
                                                        type="submit"
                                                        class="btn btn-sm <%= Number(inf.activo) === 1
                                                            ? 'btn-outline-secondary'
                                                            : 'btn-outline-success' %>"
                                                    >
                                                        <%= Number(inf.activo) === 1
                                                            ? 'Deshabilitar'
                                                            : 'Habilitar' %>
                                                    </button>

                                                </form>

                                            </td>


                                            <!-- ACCIONES -->
                                            <td class="text-end pe-3">

                                                <div class="d-flex flex-column gap-2 align-items-end">

                                                    <!-- EDITAR -->
                                                    <button
                                                        type="button"
                                                        class="btn btn-sm btn-outline-primary btn-editar-inflable"

                                                        data-id="<%= inf.id %>"
                                                        data-nombre="<%= inf.nombre %>"
                                                        data-largo="<%= inf.largo_m ?? '' %>"
                                                        data-ancho="<%= inf.ancho_m ?? '' %>"
                                                        data-alto="<%= inf.alto_m ?? '' %>"
                                                        data-requisitos="<%= inf.requisitos_instalacion || '' %>"
                                                        data-precio="<%= inf.precio_completo %>"
                                                        data-imagen="<%= inf.imagen || '' %>"
                                                        data-descripcion="<%= inf.descripcion_imagen || '' %>"
                                                    >
                                                        ✏️ Editar
                                                    </button>


                                                    <!-- ELIMINAR -->
                                                    <form
                                                        action="/admin/inflables/eliminar/<%= inf.id %>"
                                                        method="POST"
                                                        onsubmit="return confirm('¿Seguro que deseas eliminar este inflable? Si tiene reservaciones o revisiones asociadas, es posible que no se pueda eliminar.');"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                        >
                                                            🗑️ Eliminar
                                                        </button>

                                                    </form>

                                                </div>

                                            </td>

                                        </tr>

                                    <% }) %>

                                <% } else { %>

                                    <tr>
                                        <td
                                            colspan="6"
                                            class="text-center text-muted py-5"
                                        >
                                            No hay inflables registrados.
                                        </td>
                                    </tr>

                                <% } %>

                            </tbody>

                        </table>

                    </div>
                </div>

            </div>

        </div>

    </div>

</div>


<!-- BOOTSTRAP 5 JAVASCRIPT -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


<!-- JAVASCRIPT PARA EDITAR -->
<script>

    const panelEditar = document.getElementById(
        'panelEditarInflable'
    );

    const formEditar = document.getElementById(
        'formEditarInflable'
    );

    const imagenActual = document.getElementById(
        'imagenActualEditar'
    );

    const textoSinImagen = document.getElementById(
        'textoSinImagen'
    );


    // ABRIR FORMULARIO DE EDICIÓN
    document.querySelectorAll('.btn-editar-inflable')
        .forEach(boton => {

            boton.addEventListener('click', () => {

                const datos = boton.dataset;

                // Configurar ruta de edición
                formEditar.action =
                    `/admin/inflables/editar/${datos.id}`;

                // Rellenar datos del inflable
                document.getElementById('nombreEditar').value =
                    datos.nombre || '';

                document.getElementById('largoEditar').value =
                    datos.largo || '';

                document.getElementById('anchoEditar').value =
                    datos.ancho || '';

                document.getElementById('altoEditar').value =
                    datos.alto || '';

                document.getElementById('requisitosEditar').value =
                    datos.requisitos || '';

                document.getElementById('precioEditar').value =
                    datos.precio || '';

                document.getElementById('descripcionEditar').value =
                    datos.descripcion || '';

                // Limpiar selección anterior de archivo
                document.getElementById('imagenEditar').value = '';

                // Mostrar fotografía actual
                if (datos.imagen) {

                    imagenActual.src = datos.imagen;

                    imagenActual.classList.remove('d-none');
                    textoSinImagen.classList.add('d-none');

                } else {

                    imagenActual.removeAttribute('src');

                    imagenActual.classList.add('d-none');
                    textoSinImagen.classList.remove('d-none');

                }

                // Mostrar formulario de edición
                panelEditar.classList.remove('d-none');

                panelEditar.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });

            });
        });


    // CANCELAR EDICIÓN
    document.getElementById('btnCancelarEdicion')
        .addEventListener('click', () => {

            formEditar.reset();

            panelEditar.classList.add('d-none');

        });

</script>

</body>
</html>
