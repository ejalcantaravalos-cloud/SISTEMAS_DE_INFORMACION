
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Inicio | Diversión y Eventos</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <!-- Bootstrap Icons -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >
<link rel="stylesheet" href="/css/VistaPublico.css">
</head>

<body>

    <!-- NAVEGACIÓN -->
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">

            <a class="navbar-brand" href="/">
                <i class="bi bi-stars me-2"></i>
                Diversión & Eventos
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarPrincipal"
                aria-controls="navbarPrincipal"
                aria-expanded="false"
                aria-label="Mostrar navegación">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse"
                 id="navbarPrincipal">

                <ul class="navbar-nav ms-auto gap-lg-3">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Inicio
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#servicios">
                            Servicios
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="#nosotros">
                            Nosotros
                        </a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>


    <!-- PRESENTACIÓN PRINCIPAL -->
    <header class="hero">
        <div class="container">
            <div class="row align-items-center g-4">

                <div class="col-lg-7">

                    <span class="badge bg-light text-dark mb-3 px-3 py-2">
                        ¡Bienvenidos!
                    </span>

                    <h1 class="mb-4">
                        Momentos especiales,
                        diversión inolvidable.
                    </h1>

                    <p class="mb-4">
                        Descubre un lugar donde la diversión,
                        las celebraciones y la buena comida
                        se reúnen.

                        Contamos con salones para eventos,
                        juegos inflables y restaurante
                        para disfrutar en familia.
                    </p>

                    <a href="#servicios"
                       class="btn-personalizado">

                        Conocer nuestros servicios
                        <i class="bi bi-arrow-down ms-2"></i>

                    </a>
                </div>

                <div class="col-lg-5 text-center">
                    <i class="bi bi-balloon-heart hero-icon"></i>
                </div>

            </div>
        </div>
    </header>


    <!-- SERVICIOS -->
    <main>

        <section id="servicios" class="seccion-servicios">

            <div class="container">

                <div class="text-center mb-5">

                    <span class="text-uppercase fw-semibold text-secondary">
                        Explora
                    </span>

                    <h2 class="titulo-seccion mt-2">
                        Nuestros Servicios
                    </h2>

                    <p class="text-muted">
                        Tenemos algo especial para cada ocasión.
                    </p>

                </div>

                <div class="row g-4">

                    <!-- SALONES -->
                    <div class="col-md-4">

                        <div class="card card-servicio h-100">

                            <div class="imagen-servicio salones">
                                🎉
                            </div>

                            <div class="card-body d-flex flex-column">

                                <h4>Salones de Eventos</h4>

                                <p>
                                    Espacios para celebrar cumpleaños,
                                    reuniones familiares y momentos
                                    importantes con tus seres queridos.
                                </p>

                                <a href="/salones"
                                   class="btn btn-servicio mt-auto">

                                    Conocer Salones
                                    <i class="bi bi-arrow-right ms-2"></i>

                                </a>

                            </div>
                        </div>
                    </div>


                    <!-- INFLABLES -->
                    <div class="col-md-4">

                        <div class="card card-servicio h-100">

                            <div class="imagen-servicio inflables">
                                🏰
                            </div>

                            <div class="card-body d-flex flex-column">

                                <h4>Juegos Inflables</h4>

                                <p>
                                    Explora nuestro catálogo de
                                    brincolines y juegos inflables.
                                    Consulta sus medidas y características
                                    para elegir el ideal para tu evento.
                                </p>

                                <a href="/Inflables"
                                   class="btn btn-servicio mt-auto">

                                    Ver Brincolines
                                    <i class="bi bi-arrow-right ms-2"></i>

                                </a>

                            </div>
                        </div>
                    </div>


                    <!-- RESTAURANTE -->
                    <div class="col-md-4">

                        <div class="card card-servicio h-100">

                            <div class="imagen-servicio restaurante">
                                🍔
                            </div>

                            <div class="card-body d-flex flex-column">

                                <h4>Restaurante</h4>

                                <p>
                                    Conoce nuestro menú de comida rápida,
                                    descubre los platillos disponibles
                                    y consulta sus precios.
                                </p>

                                <a href="/restaurante"
                                   class="btn btn-servicio mt-auto">

                                    Ver Menú
                                    <i class="bi bi-arrow-right ms-2"></i>

                                </a>

                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </section>


        <!-- SOBRE EL NEGOCIO -->
        <section id="nosotros" class="seccion-nosotros">

            <div class="container">

                <div class="text-center mb-5">
                    <h2 class="titulo-seccion">
                        ¿Por qué visitarnos?
                    </h2>

                    <p class="text-muted">
                        Un lugar pensado para compartir
                        y disfrutar momentos especiales.
                    </p>
                </div>

                <div class="row text-center g-4">

                    <div class="col-md-4">
                        <i class="bi bi-people icono-info"></i>
                        <h5 class="fw-bold mt-3">
                            Para toda la familia
                        </h5>
                        <p class="text-muted">
                            Actividades y espacios para
                            disfrutar en compañía.
                        </p>
                    </div>

                    <div class="col-md-4">
                        <i class="bi bi-balloon icono-info"></i>
                        <h5 class="fw-bold mt-3">
                            Diversión
                        </h5>
                        <p class="text-muted">
                            Juegos inflables para complementar
                            tus celebraciones.
                        </p>
                    </div>

                    <div class="col-md-4">
                        <i class="bi bi-cup-hot icono-info"></i>
                        <h5 class="fw-bold mt-3">
                            Comida deliciosa
                        </h5>
                        <p class="text-muted">
                            Platillos para disfrutar
                            durante tu visita.
                        </p>
                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- FOOTER -->
    <footer class="text-center">
        <div class="container">

            <h5 class="text-white fw-bold">
                <i class="bi bi-stars me-2"></i>
                Diversión & Eventos
            </h5>

            <p class="mb-0">
                Celebraciones, diversión y buena comida
                en un solo lugar.
            </p>

            <small class="d-block mt-3">
                © <%= new Date().getFullYear() %>
                Todos los derechos reservados.
            </small>

        </div>
    </footer>


    <!-- Bootstrap JS -->
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
