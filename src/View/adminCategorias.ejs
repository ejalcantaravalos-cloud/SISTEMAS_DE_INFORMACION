<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gestión de categorías | ZAVABA</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root { --violeta: #7048c6; --violeta-oscuro: #5734a4; --fondo: #f6f5fa; --tinta: #252339; }
    body { background: var(--fondo); color: var(--tinta); font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
    .navbar-panel { background: #211b38; }
    .navbar-panel .nav-link { color: #d9d4e8; border-radius: .65rem; padding: .55rem .8rem !important; }
    .navbar-panel .nav-link:hover, .navbar-panel .nav-link.active { background: rgba(255,255,255,.13); color: #fff; }
    .navbar-brand { font-weight: 750; }
    .page-wrap { max-width: 1250px; }
    .eyebrow { color: var(--violeta); font-size: .77rem; letter-spacing: .09em; text-transform: uppercase; font-weight: 750; }
    .panel-card { border: 1px solid #e9e6f0; border-radius: 1.05rem; box-shadow: 0 6px 22px rgba(33,27,56,.04); }
    .btn-brand { background: var(--violeta); border-color: var(--violeta); color: #fff; }
    .btn-brand:hover, .btn-brand:focus { background: var(--violeta-oscuro); border-color: var(--violeta-oscuro); color: #fff; }
    .form-control:focus { border-color: #aa93df; box-shadow: 0 0 0 .2rem rgba(112,72,198,.12); }
    .stat-icon { height: 46px; width: 46px; background: #eee7fc; border-radius: 14px; display: grid; place-items: center; color: #6541b4; font-size: 1.2rem; }
    .muted { color: #716c7b; }
    .table thead th { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: #77728c; font-weight: 750; }
    .table td, .table th { vertical-align: middle; }
    .table tbody tr:last-child td { border-bottom: 0; }
    .categoria-avatar { width: 38px; height: 38px; border-radius: 11px; color: #67438d; background: #eee7fc; display: grid; place-items: center; flex-shrink: 0; }
    .descripcion { max-width: 350px; overflow-wrap: anywhere; }
  </style>
</head>
<body>
<%
  const listaCategorias = Array.isArray(categorias) ? categorias : [];
  const emailAdmin = user && user.email ? user.email : 'Administrador';
%>

<nav class="navbar navbar-expand-lg navbar-dark navbar-panel py-3 mb-4">
  <div class="container-fluid page-wrap px-3 px-lg-4">
    <a class="navbar-brand text-white" href="/admin"><i class="bi bi-grid-1x2-fill me-2"></i>Diversión y Eventos <span class="text-white-50 fw-normal fs-6">/ Administración</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navegacion" aria-controls="navegacion" aria-expanded="false" aria-label="Mostrar navegación">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navegacion">
      <ul class="navbar-nav ms-lg-auto gap-lg-1">
        <li class="nav-item"><a class="nav-link" href="/admin"><i class="bi bi-house me-1"></i>Panel</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/menu/productos"><i class="bi bi-egg-fried me-1"></i>Platillos</a></li>
        <li class="nav-item"><a class="nav-link active" aria-current="page" href="/admin/menu/categorias"><i class="bi bi-tags me-1"></i>Categorías</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/menu/menus"><i class="bi bi-journal-text me-1"></i>Menús</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/ingredientes"><i class="bi bi-basket2 me-1"></i>Ingredientes</a></li>
      </ul>
    </div>
  </div>
</nav>

<main class="container-fluid page-wrap px-3 px-lg-4 pb-5">
  <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <div class="eyebrow mb-2">Organización del restaurante</div>
      <h1 class="h2 fw-bold mb-1">Gestión de categorías</h1>
      <p class="muted mb-0">Agrupa tus platillos por tipo: hamburguesas, hot dogs, postres y más.</p>
    </div>
    <a href="/admin" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver al panel</a>
  </header>

  <div class="row g-3 mb-4">
    <div class="col-md-5">
      <div class="card panel-card h-100">
        <div class="card-body d-flex align-items-center gap-3 p-3">
          <span class="stat-icon"><i class="bi bi-tags-fill"></i></span>
          <div><div class="muted small">Categorías registradas</div><div class="h3 fw-bold mb-0"><%= listaCategorias.length %></div></div>
        </div>
      </div>
    </div>
    <div class="col-md-7">
      <div class="card panel-card h-100">
        <div class="card-body d-flex align-items-center gap-3 p-3">
          <span class="stat-icon"><i class="bi bi-person-check"></i></span>
          <div><div class="muted small">Sesión de administrador</div><div class="fw-semibold text-break"><%= emailAdmin %></div></div>
        </div>
      </div>
    </div>
  </div>

  <div class="alert alert-info alert-dismissible fade show d-flex align-items-start gap-2" role="alert">
    <i class="bi bi-info-circle-fill mt-1" aria-hidden="true"></i>
    <div class="flex-grow-1 pe-3">
      <strong>Categorías y menús no son lo mismo.</strong>
      Las categorías organizan platillos por tipo; los menús definen en cuáles se publican.
      <a class="alert-link" href="/admin/menu/menus">Ir a menús</a>.
    </div>
    <button type="button" class="btn-close position-static ms-auto" data-bs-dismiss="alert" aria-label="Cerrar aviso"></button>
  </div>

  <div class="row g-4 align-items-start">
    <div class="col-lg-4">
      <section class="card panel-card">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-plus-circle text-primary fs-4"></i>
            <h2 class="h5 fw-bold mb-0">Nueva categoría</h2>
          </div>
          <form action="/admin/menu/categorias/crear" method="POST">
            <div class="mb-3">
              <label for="nombre" class="form-label fw-semibold">Nombre <span class="text-danger">*</span></label>
              <input class="form-control" id="nombre" name="nombre" type="text" maxlength="100" required placeholder="Ej. Hamburguesas" autocomplete="off">
            </div>
            <div class="mb-3">
              <label for="descripcion" class="form-label fw-semibold">Descripción</label>
              <textarea class="form-control" id="descripcion" name="descripcion" rows="3" placeholder="Ej. Hamburguesas clásicas y especiales"></textarea>
              <div class="form-text">Opcional. Ayuda a identificar la sección.</div>
            </div>
            <button type="submit" class="btn btn-brand w-100"><i class="bi bi-check2-circle me-1"></i> Guardar categoría</button>
          </form>
        </div>
      </section>
    </div>

    <div class="col-lg-8">
      <section class="card panel-card">
        <div class="card-body p-4">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <div>
              <h2 class="h5 fw-bold mb-1">Categorías registradas</h2>
              <div class="muted small">Consulta las categorías de tus platillos.</div>
            </div>
            <div class="input-group" style="max-width: 255px;">
              <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
              <input id="buscarCategoria" class="form-control" type="search" placeholder="Buscar categoría" aria-label="Buscar categoría">
            </div>
          </div>
          <% if (listaCategorias.length === 0) { %>
            <div class="text-center py-5">
              <i class="bi bi-inboxes display-5 text-secondary"></i>
              <h3 class="h6 mt-3">Todavía no hay categorías</h3>
              <p class="muted small mb-0">Crea la primera desde el formulario de la izquierda.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead><tr><th scope="col">Categoría</th><th scope="col">Descripción</th><th scope="col" class="text-end">Acción</th></tr></thead>
                <tbody id="tablaCategorias">
                  <% listaCategorias.forEach(cat => { %>
                    <tr class="fila-categoria">
                      <td>
                        <div class="d-flex align-items-center gap-2">
                          <span class="categoria-avatar"><i class="bi bi-tag"></i></span>
                          <div><div class="fw-semibold nombre-categoria"><%= cat.nombre %></div><span class="muted small">ID #<%= cat.id %></span></div>
                        </div>
                      </td>
                      <td class="descripcion small"><%= cat.descripcion || 'Sin descripción' %></td>
                      <td class="text-end">
                        <form method="POST" action="/admin/menu/categorias/eliminar/<%= cat.id %>" class="d-inline form-eliminar">
                          <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Eliminar categoría <%= cat.nombre %>"><i class="bi bi-trash3 me-1"></i>Eliminar</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <p id="sinResultados" class="text-center muted py-4 mb-0 d-none">No encontramos categorías con ese nombre.</p>
          <% } %>
        </div>
      </section>
    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const buscador = document.getElementById('buscarCategoria');
  if (buscador) {
    buscador.addEventListener('input', () => {
      const termino = buscador.value.trim().toLocaleLowerCase('es');
      let visibles = 0;
      document.querySelectorAll('.fila-categoria').forEach(fila => {
        const visible = fila.querySelector('.nombre-categoria').textContent.toLocaleLowerCase('es').includes(termino);
        fila.classList.toggle('d-none', !visible);
        if (visible) visibles++;
      });
      const sinResultados = document.getElementById('sinResultados');
      if (sinResultados) sinResultados.classList.toggle('d-none', visibles !== 0);
    });
  }

  document.querySelectorAll('.form-eliminar').forEach(formulario => {
    formulario.addEventListener('submit', evento => {
      const aceptado = confirm('¿Eliminar esta categoría? Los platillos asociados quedarán sin categoría, pero no se eliminarán.');
      if (!aceptado) evento.preventDefault();
    });
  });
</script>
</body>
</html>
