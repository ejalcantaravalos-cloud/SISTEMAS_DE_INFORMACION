<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Administración de sonido | ZABAVA</title>

    <!-- BOOTSTRAP -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- BOOTSTRAP ICONS -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <style>

        :root {
            --morado: #9062db;
            --morado-oscuro: #7546c8;
            --morado-claro: #f0e8fc;
        }

        body {
            background-color: #f8f6fc;
            color: #303046;
        }

        .navbar {
            background-color: var(--morado);
        }

        .btn-morado {
            background-color: var(--morado);
            color: white;
            border: none;
        }

        .btn-morado:hover,
        .btn-morado:focus {
            background-color: var(--morado-oscuro);
            color: white;
        }

        .btn-editar {
            background-color: var(--morado-claro);
            color: var(--morado-oscuro);
            border: none;
        }

        .btn-editar:hover {
            background-color: #e0d0fa;
            color: var(--morado-oscuro);
        }

        .card-equipo {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0, 0, 0, .08);
            transition: transform .2s ease;
        }

        .card-equipo:hover {
            transform: translateY(-3px);
        }

        .imagen-contenedor {
            position: relative;
            height: 220px;
            background: #f0ecf8;
            overflow: hidden;
        }

        .imagen-equipo {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 10px;
        }

        .sin-imagen {
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #9c89ba;
            gap: 8px;
        }

        .sin-imagen i {
            font-size: 4rem;
        }

        .estado-equipo {
            position: absolute;
            top: 15px;
            right: 15px;
        }

        .precio-equipo {
            color: var(--morado-oscuro);
            font-weight: 750;
            font-size: 1.5rem;
        }

        .descripcion-equipo {
            color: #686078;
            white-space: pre-line;
            overflow-wrap: anywhere;
            font-size: .92rem;
        }

        .detalle-equipo {
            background-color: #f8f6fc;
            border-radius: 10px;
            padding: 12px;
        }

        .modal-content {
            border: none;
            border-radius: 18px;
            overflow: hidden;
        }

        .modal-header {
            background-color: var(--morado);
            color: white;
        }

        .form-label {
            font-weight: 600;
        }

        .form-control:focus {
            border-color: var(--morado);
            box-shadow: 0 0 0 .2rem rgba(144, 98, 219, .15);
        }

        .zona-imagen {
            border: 2px dashed #d6c4f3;
            border-radius: 12px;
            background: #faf7ff;
            padding: 20px;
        }

        .imagen-edicion {
            width: 100%;
            height: 160px;
            object-fit: contain;
            background: #f0ecf8;
            border-radius: 10px;
        }

        .icono-titulo {
            color: var(--morado);
        }

    </style>

</head>

<body>


    <nav class="navbar navbar-dark">

        <div class="container">

            <a class="navbar-brand fw-bold" href="/">

                <i class="bi bi-stars me-2"></i>

               ZAVABA

            </a>

            <a href="/admin/salones"
               class="btn btn-outline-light btn-sm">

                <i class="bi bi-arrow-left me-1"></i>

                Salones

            </a>

             <a href="/admin"> <i class="bi bi-arrow-left me-1"></i>Panel</a> 

        </div>

    </nav>


    <main class="container py-5">

        <!-- ENCABEZADO -->

        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mb-4">

            <div>

                <h1 class="fw-bold mb-1">

                    <i class="bi bi-speaker icono-titulo me-2"></i>

                    Equipos de sonido

                </h1>

                <p class="text-muted mb-0">

                    Administra los equipos disponibles
                    para los paquetes de eventos.

                </p>

            </div>

            <button
                type="button"
                class="btn btn-morado px-4 py-2"
                data-bs-toggle="modal"
                data-bs-target="#modalCrearSonido"
            >

                <i class="bi bi-plus-lg me-2"></i>

                Nuevo equipo

            </button>

        </div>


        <!-- MENSAJES DEL SISTEMA -->

        <% if (aviso) { %>

            <div class="alert alert-info
                        alert-dismissible fade show">

                <i class="bi bi-info-circle me-2"></i>

                <%= aviso %>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"
                ></button>

            </div>

        <% } %>


        <!-- BUSCADOR -->

        <form
            action="/admin/sonido"
            method="GET"
            class="mb-4"
        >

            <div class="input-group">

                <span class="input-group-text bg-white">

                    <i class="bi bi-search"></i>

                </span>

                <input
                    type="search"
                    name="buscar"
                    class="form-control"
                    placeholder="Buscar equipo de sonido..."
                    value="<%= busqueda %>"
                >

                <button class="btn btn-morado"
                        type="submit">

                    Buscar

                </button>

                <% if (busqueda) { %>

                    <a href="/admin/sonido"
                       class="btn btn-outline-secondary">

                        Limpiar

                    </a>

                <% } %>

            </div>

        </form>


        <div class="row g-4">

            <% if (equipos && equipos.length > 0) { %>

                <% equipos.forEach(equipo => { %>

                    <div class="col-md-6 col-lg-4">

                        <article class="card card-equipo h-100">

                            <!-- FOTOGRAFÍA -->

                            <div class="imagen-contenedor">

                                <% if (equipo.imagen_url) { %>

                                    <img
                                        src="<%= equipo.imagen_url %>"
                                        class="imagen-equipo"
                                        alt="<%= equipo.nombre %>"
                                        loading="lazy"
                                    >

                                <% } else { %>

                                    <div class="sin-imagen">

                                        <i class="bi bi-speaker"></i>

                                        <span>Sin fotografía</span>

                                    </div>

                                <% } %>


                                <!-- ESTADO -->

                                <span class="estado-equipo badge rounded-pill
                                    <%= Number(equipo.activo) === 1
                                        ? 'text-bg-success'
                                        : 'text-bg-secondary' %>">

                                    <%= Number(equipo.activo) === 1
                                        ? 'Activo'
                                        : 'Inactivo' %>

                                </span>

                            </div>


                            <!-- INFORMACIÓN -->

                            <div class="card-body d-flex
                                        flex-column gap-3">

                                <h3 class="h5 fw-bold mb-0">

                                    <%= equipo.nombre %>

                                </h3>

                                <p class="descripcion-equipo mb-0">

                                    <%= equipo.descripcion ||
                                        'Sin descripción registrada.' %>

                                </p>


                                <!-- PRECIO -->

                                <div>

                                    <div class="small text-muted">

                                        Precio de renta por unidad

                                    </div>

                                    <div class="precio-equipo">

                                        <%= Number(
                                            equipo.precio_renta
                                        ).toLocaleString(
                                            'es-MX',
                                            {
                                                style: 'currency',
                                                currency: 'MXN'
                                            }
                                        ) %>

                                    </div>

                                </div>


                                <!-- EXISTENCIAS -->

                                <div class="detalle-equipo">

                                    <i class="bi bi-box-seam me-2"></i>

                                    Existencias totales:

                                    <strong>

                                        <%= equipo.stock_total %>

                                    </strong>

                                    <% if (Number(equipo.stock_total) === 0) { %>

                                        <span class="badge text-bg-warning ms-1">

                                            Sin existencias

                                        </span>

                                    <% } %>

                                </div>


                                <!-- BOTONES ADMINISTRATIVOS -->

                                <div class="mt-auto">

                                    <hr>

                                    <div class="d-flex gap-2">

                                        <!-- EDITAR -->

                                        <button
                                            type="button"
                                            class="btn btn-editar flex-fill"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarSonido<%= equipo.id %>"
                                        >

                                            <i class="bi bi-pencil-square me-1"></i>

                                            Editar

                                        </button>


                                        <!-- CAMBIAR ESTADO -->

                                        <form
                                            method="POST"
                                            action="/admin/sonido/estado/<%= equipo.id %>"
                                            class="flex-fill"
                                        >

                                            <input
                                                type="hidden"
                                                name="activo"
                                                value="<%= Number(equipo.activo) === 1 ? 0 : 1 %>"
                                            >

                                            <button
                                                type="submit"
                                                class="btn w-100
                                                    <%= Number(equipo.activo) === 1
                                                        ? 'btn-outline-danger'
                                                        : 'btn-outline-success' %>"
                                            >

                                                <i class="bi bi-power me-1"></i>

                                                <%= Number(equipo.activo) === 1
                                                    ? 'Desactivar'
                                                    : 'Activar' %>

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </article>

                    </div>

                <% }); %>

            <% } else { %>

                <div class="col-12 text-center py-5">

                    <i class="bi bi-speaker display-3
                              icono-titulo"></i>

                    <h4 class="mt-3 fw-bold">

                        No hay equipos para mostrar

                    </h4>

                    <p class="text-muted">

                        Registra un equipo de sonido
                        o modifica tu búsqueda.

                    </p>

                </div>

            <% } %>

        </div>

    </main>


    <!-- =====================================
         MODALES DE CREACIÓN Y EDICIÓN
    ====================================== -->

    <% [null, ...equipos].forEach(equipo => { %>

        <%

            const editando = equipo !== null;

            const modalId = editando
                ? 'modalEditarSonido' + equipo.id
                : 'modalCrearSonido';

            const accion = editando
                ? '/admin/sonido/editar/' + equipo.id
                : '/admin/sonido/crear';

        %>

        <div
            class="modal fade"
            id="<%= modalId %>"
            tabindex="-1"
            aria-labelledby="<%= modalId %>Titulo"
            aria-hidden="true"
        >

            <div class="modal-dialog modal-dialog-centered
                        modal-dialog-scrollable modal-lg">

                <div class="modal-content">

                    <!-- ENCABEZADO -->

                    <div class="modal-header">

                        <h2 class="modal-title fs-5 fw-bold"
                            id="<%= modalId %>Titulo">

                            <i class="bi bi-speaker me-2"></i>

                            <%= editando
                                ? 'Editar equipo de sonido'
                                : 'Registrar equipo de sonido' %>

                        </h2>

                        <button
                            type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"
                        ></button>

                    </div>


                    <!-- FORMULARIO -->

                    <form
                        action="<%= accion %>"
                        method="POST"
                        enctype="multipart/form-data"
                        class="d-flex flex-column overflow-hidden"
                    >

                        <div class="modal-body p-4">

                            <!-- NOMBRE -->

                            <div class="mb-3">

                                <label class="form-label"
                                       for="<%= modalId %>Nombre">

                                    Nombre del equipo

                                </label>

                                <input
                                    type="text"
                                    name="nombre"
                                    id="<%= modalId %>Nombre"
                                    class="form-control"
                                    maxlength="120"
                                    placeholder="Ej. Bocina con micrófono"
                                    value="<%= editando ? equipo.nombre : '' %>"
                                    required
                                >

                            </div>


                            <!-- DESCRIPCIÓN -->

                            <div class="mb-3">

                                <label class="form-label"
                                       for="<%= modalId %>Descripcion">

                                    Descripción

                                </label>

                                <textarea
                                    name="descripcion"
                                    id="<%= modalId %>Descripcion"
                                    class="form-control"
                                    rows="3"
                                    placeholder="Características del equipo..."
                                ><%= editando ? (equipo.descripcion || '') : '' %></textarea>

                            </div>


                            <div class="row g-3 mb-4">

                                <!-- PRECIO -->

                                <div class="col-md-6">

                                    <label class="form-label"
                                           for="<%= modalId %>Precio">

                                        Precio de renta

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">

                                            $

                                        </span>

                                        <input
                                            type="number"
                                            name="precio_renta"
                                            id="<%= modalId %>Precio"
                                            class="form-control"
                                            min="0"
                                            max="9999999999.99"
                                            step="0.01"
                                            value="<%= editando ? equipo.precio_renta : '' %>"
                                            required
                                        >

                                    </div>

                                </div>


                                <!-- EXISTENCIAS -->

                                <div class="col-md-6">

                                    <label class="form-label"
                                           for="<%= modalId %>Stock">

                                        Existencias totales

                                    </label>

                                    <input
                                        type="number"
                                        name="stock_total"
                                        id="<%= modalId %>Stock"
                                        class="form-control"
                                        min="0"
                                        max="2147483647"
                                        step="1"
                                        value="<%= editando ? equipo.stock_total : 1 %>"
                                        required
                                    >

                                </div>

                            </div>


                            <!-- FOTOGRAFÍA ACTUAL -->

                            <% if (editando && equipo.imagen_url) { %>

                                <div class="mb-3">

                                    <label class="form-label">

                                        Fotografía actual

                                    </label>

                                    <img
                                        src="<%= equipo.imagen_url %>"
                                        class="imagen-edicion"
                                        alt="<%= equipo.nombre %>"
                                    >

                                </div>

                            <% } %>


                            <!-- SUBIR FOTOGRAFÍA -->

                            <div class="zona-imagen">

                                <label class="form-label"
                                       for="<%= modalId %>Imagen">

                                    <i class="bi bi-image me-2"></i>

                                    <%= editando && equipo.imagen_url
                                        ? 'Reemplazar fotografía'
                                        : 'Agregar fotografía' %>

                                </label>

                                <input
                                    type="file"
                                    name="imagen"
                                    id="<%= modalId %>Imagen"
                                    class="form-control"
                                    accept="image/jpeg,image/png,image/webp"
                                >

                                <div class="form-text">

                                    JPG, PNG o WEBP.
                                    Máximo 5 MB.

                                    <% if (editando) { %>

                                        Deja vacío este campo
                                        para conservar la imagen actual.

                                    <% } else { %>

                                        Campo opcional.

                                    <% } %>

                                </div>

                            </div>

                        </div>


                        <!-- BOTONES DEL FORMULARIO -->

                        <div class="modal-footer">

                            <% if (editando && equipo.imagen_url) { %>

                                <button
                                    type="submit"
                                    form="eliminarImagen<%= equipo.id %>"
                                    class="btn btn-outline-danger me-auto"
                                >

                                    <i class="bi bi-trash me-1"></i>

                                    Eliminar foto

                                </button>

                            <% } %>

                            <button
                                type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                            >

                                Cancelar

                            </button>

                            <button
                                type="submit"
                                class="btn btn-morado"
                            >

                                <i class="bi bi-check-lg me-1"></i>

                                <%= editando
                                    ? 'Guardar cambios'
                                    : 'Registrar equipo' %>

                            </button>

                        </div>

                    </form>


                    <!-- FORMULARIO INDEPENDIENTE
                         PARA ELIMINAR LA IMAGEN -->

                    <% if (editando && equipo.imagen_url) { %>

                        <form
                            id="eliminarImagen<%= equipo.id %>"
                            action="/admin/sonido/<%= equipo.id %>/imagen/eliminar"
                            method="POST"
                            onsubmit="return confirm('¿Deseas eliminar la fotografía de este equipo?');"
                        ></form>

                    <% } %>

                </div>

            </div>

        </div>

    <% }); %>


    <!-- PIE DE PÁGINA -->

    <footer class="text-center py-4 text-muted">

        <p class="mb-0">

            HelpingBee | Administración de eventos

        </p>

    </footer>


    <!-- BOOTSTRAP JAVASCRIPT -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

</body>

</html>