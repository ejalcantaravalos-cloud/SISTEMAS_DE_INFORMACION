<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Administración de usuarios | Sistema Integral</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/admin.css" rel="stylesheet">
</head>
<body>
<%
  const lista = Array.isArray(usuarios) ? usuarios : [];
  const activos = lista.filter(u => Number(u.activo) === 1).length;
  const catalogoRoles = [...new Set(lista.flatMap(u => Array.isArray(u.roles) ? u.roles : []))]
    .sort((a, b) => a.localeCompare(b, 'es'));
  const fechaCorta = (valor) => {
    if (!valor) return 'Sin fecha';
    const fecha = new Date(valor);
    return Number.isNaN(fecha.getTime())
      ? 'Sin fecha'
      : fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
  };
%>

<!-- BARRA SUPERIOR SOLO PARA MÓVILES / TABLETS -->
<header class="navbar navbar-dark navbar-panel d-lg-none px-3 py-2 sticky-top shadow-sm">
  <div class="d-flex align-items-center justify-content-between w-100">
    <a class="navbar-brand d-flex align-items-center gap-2 mb-0" href="/admin">
      <span class="bg-white bg-opacity-10 rounded-3 px-2 py-1"><i class="bi bi-grid-1x2-fill"></i></span>
      <span class="fw-semibold">Sistema Integral</span>
    </a>
    <button class="btn btn-outline-light btn-sm rounded-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarAdmin" aria-controls="sidebarAdmin">
      <i class="bi bi-list fs-5"></i>
    </button>
  </div>
</header>

<aside class="offcanvas-lg offcanvas-start navbar-panel text-white admin-sidebar d-flex flex-column shadow" tabindex="-1" id="sidebarAdmin" aria-labelledby="sidebarAdminLabel">
  <!-- Cabecera del Sidebar -->
  <div class="p-3 p-lg-4 border-bottom border-white border-opacity-10 d-flex align-items-center justify-content-between">
<a class="navbar-brand d-flex align-items-center gap-2 text-white text-decoration-none" href="/admin" id="sidebarAdminLabel">
      <img src="/logo.jpeg" alt="Logo" class="rounded-3 flex-shrink-0" style="width: 36px; height: 36px; object-fit: contain;">
      <div>
        <div class="fw-bold lh-1">Sistema Integral</div>
        <small class="text-white-50" style="font-size: 0.75rem;">Panel de Administración</small>
      </div>
    </a>
    <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebarAdmin" aria-label="Cerrar menú"></button>
  </div>


  <div class="p-3 flex-grow-1 overflow-y-auto sidebar-nav">
    

    <div class="sidebar-label mb-2">Operación</div>
    <ul class="nav flex-column gap-1 mb-4">
      <li class="nav-item">
        <a class="nav-link justify-content-between" data-bs-toggle="collapse" href="#submenuRestaurante" role="button" aria-expanded="true" aria-controls="submenuRestaurante">
          <span class="d-flex align-items-center gap-2">
            <i class="bi bi-shop fs-5 text-warning"></i>
            <span>Restaurante</span>
          </span>
          <i class="bi bi-chevron-down chevron-icon"></i>
        </a>

        <div class="collapse show mt-1" id="submenuRestaurante">
          <ul class="nav flex-column gap-1 sidebar-submenu">
            <li class="nav-item">
              <a class="nav-link" href="/admin/menu/menus">
                <i class="bi bi-journal-text"></i> Menús
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/menu/categorias">
                <i class="bi bi-tags"></i> Categorías
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/menu/productos">
                <i class="bi bi-egg-fried"></i> Platillos
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/ingredientes">
                <i class="bi bi-basket"></i> Ingredientes
              </a>
            </li>
          </ul>
        </div>
      </li>


      <li class="nav-item">
        <a class="nav-link collapsed justify-content-between" data-bs-toggle="collapse" href="#submenuEventos" role="button" aria-expanded="false" aria-controls="submenuEventos">
          <span class="d-flex align-items-center gap-2">
            <i class="bi bi-stars fs-5"></i>
            <span>Eventos y Media</span>
          </span>
          <i class="bi bi-chevron-down chevron-icon"></i>
        </a>
        <div class="collapse mt-1" id="submenuEventos">
          <ul class="nav flex-column gap-1 sidebar-submenu">
            <li class="nav-item">
              <a class="nav-link" href="/admin/salones">
                <i class="bi bi-building"></i> Salones
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/admin/inflables">
                <i class="bi bi-balloon"></i> Inflables
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/panel-imagenes">
                <i class="bi bi-images"></i> Imágenes
              </a>
            </li>
              <li class="nav-item">
              <a class="nav-link" href="/admin/sonido">
                <i class="bi bi-images"></i> Sonido para salones
              </a>
            </li>
                          <li class="nav-item">
              <a class="nav-link" href="/admin/manteles">
                <i class="bi bi-images"></i> Manteles
              </a>
            </li>
                </li>
                          <li class="nav-item">
              <a class="nav-link" href="/admin/paquetes">
                <i class="bi bi-images"></i> Paquetes para eventos
              </a>
            </li>
          </ul>
        </div>
      </li>
    </ul>


    <div class="sidebar-label mb-2">Sistema</div>
    <ul class="nav flex-column gap-1">
      <li class="nav-item">
        <a class="nav-link active" aria-current="page" href="/admin">
          <i class="bi bi-people-fill fs-5"></i>
          <span>Usuarios y Roles</span>
        </a>
      </li>
    </ul>
  </div>


  <div class="p-3 border-top border-white border-opacity-10 bg-black bg-opacity-10">
<div class="d-flex align-items-center gap-2 mb-3 px-2">
      <img src="/Dazai.jpg" alt="Perfil" class="rounded-circle border border-white border-opacity-25 flex-shrink-0" style="width: 36px; height: 36px; object-fit: cover;">
      <div class="overflow-hidden">
        <div class="small fw-semibold text-truncate"><%= user.email %></div>
        <div class="text-white-50" style="font-size: 0.72rem;"><i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i>En línea</div>
      </div>
    </div>
    <a class="btn btn-outline-warning btn-sm w-100 rounded-3 d-flex align-items-center justify-content-center gap-2" href="/logout">
      <i class="bi bi-box-arrow-right"></i> Cerrar sesión
    </a>
  </div>
</aside>


<div class="admin-main-wrapper">
  <main class="container-fluid admin-container px-3 px-lg-5 py-4 py-lg-5 flex-grow-1">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
      <div>
        <div class="eyebrow mb-1">Panel de administración</div>
        <h1 class="page-title fw-bold mb-1">Gestión de usuarios</h1>
        <p class="section-subtitle mb-0">Administra las cuentas y los roles del personal.</p>
      </div>
      <a class="btn btn-brand btn-lg rounded-3 px-4 align-self-start shadow-sm" href="/admin/users/new">
        <i class="bi bi-person-plus me-2"></i> Nuevo usuario
      </a>
    </div>

    <!-- Tarjetas de resumen (KPIs) -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm"><div class="card-body p-4 d-flex align-items-center gap-3">
          <span class="stat-icon purple"><i class="bi bi-people-fill"></i></span>
          <div><div class="small section-subtitle">Usuarios registrados</div><div class="fs-3 fw-bold lh-sm"><%= lista.length %></div></div>
        </div></div>
      </div>
      <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm"><div class="card-body p-4 d-flex align-items-center gap-3">
          <span class="stat-icon green"><i class="bi bi-person-check-fill"></i></span>
          <div><div class="small section-subtitle">Cuentas activas</div><div class="fs-3 fw-bold lh-sm"><%= activos %></div></div>
        </div></div>
      </div>
      <div class="col-12 col-md-4">
        <div class="card h-100 border-0 shadow-sm"><div class="card-body p-4 d-flex align-items-center gap-3">
          <span class="stat-icon blue"><i class="bi bi-shield-lock-fill"></i></span>
          <div><div class="small section-subtitle">Roles asignados distintos</div><div class="fs-3 fw-bold lh-sm"><%= catalogoRoles.length %></div></div>
        </div></div>
      </div>
    </div>

    <!-- Tabla de usuarios -->
    <section class="card border-0 shadow-sm overflow-hidden">
      <div class="card-body p-3 p-md-4 border-bottom bg-white">
        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-xl-center gap-3">
          <div>
            <h2 class="h5 fw-bold mb-1">Directorio de empleados</h2>
            <p class="section-subtitle small mb-0"><span id="contadorVisibles"><%= lista.length %></span> usuario(s) visible(s)</p>
          </div>
          <div class="d-flex flex-column flex-sm-row gap-2">
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
              <input id="buscarUsuario" type="search" class="form-control search-input" placeholder="Buscar nombre o correo" aria-label="Buscar usuarios">
            </div>
            <select id="filtrarRol" class="form-select" aria-label="Filtrar por rol">
              <option value="">Todos los roles</option>
              <% catalogoRoles.forEach(rol => { %>
                <option value="<%= rol %>"><%= rol %></option>
              <% }); %>
            </select>
          </div>
        </div>
      </div>

      <% if (lista.length === 0) { %>
        <div class="text-center px-4 py-5 bg-white">
          <i class="bi bi-people display-4 text-secondary"></i>
          <h3 class="h5 mt-3">Todavía no hay usuarios registrados</h3>
          <p class="text-secondary">Crea la primera cuenta para comenzar.</p>
          <a href="/admin/users/new" class="btn btn-brand">Crear usuario</a>
        </div>
      <% } else { %>
        <div class="table-responsive bg-white">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr>
              <th class="ps-4 py-3">Empleado</th>
              <th class="py-3">Roles</th>
              <th class="py-3">Estado</th>
              <th class="py-3">Registrado</th>
              <th class="pe-4 py-3 text-end">Acciones</th>
            </tr></thead>
            <tbody>
              <% lista.forEach(u => { const rolesUsuario = Array.isArray(u.roles) ? u.roles : []; %>
                <tr class="fila-usuario" data-roles="<%= rolesUsuario.join('|') %>">
                  <td class="ps-4 py-3">
                    <div class="d-flex align-items-center gap-3">
                      <span class="avatar-usuario"><%= (u.nombre || '?').trim().charAt(0).toUpperCase() || '?' %></span>
                      <div>
                        <div class="fw-semibold nombre-usuario">
                          <%= u.nombre %>
                          <% if (Number(u.id) === Number(user.id)) { %><span class="badge text-bg-light border ms-1">Tú</span><% } %>
                        </div>
                        <div class="small text-secondary correo-usuario"><%= u.email %></div>
                        <div class="small text-secondary">ID #<%= u.id %></div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3" style="min-width: 210px;">
                    <% if (rolesUsuario.length > 0) { %>
                      <div class="d-flex flex-wrap gap-1">
                        <% rolesUsuario.forEach(rol => { %>
                          <span class="badge rounded-pill badge-rol <%= rol === 'Administrador' ? 'badge-admin' : rol === 'Aspirante' ? 'badge-aspirante' : 'badge-empleado' %>"><%= rol %></span>
                        <% }); %>
                      </div>
                    <% } else { %>
                      <span class="text-secondary small">Sin rol</span>
                    <% } %>
                  </td>
                  <td class="py-3">
                    <% if (Number(u.activo) === 1) { %>
                      <span class="badge rounded-pill text-bg-success bg-opacity-10 text-success border border-success-subtle"><i class="bi bi-circle-fill me-1" style="font-size: .45rem"></i> Activo</span>
                    <% } else { %>
                      <span class="badge rounded-pill text-bg-secondary">Inactivo</span>
                    <% } %>
                  </td>
                  <td class="py-3 small text-secondary text-nowrap"><%= fechaCorta(u.creado_en) %></td>
                  <td class="pe-4 py-3 text-end">
                    <div class="d-flex gap-2 justify-content-end action-buttons">
                      <a href="/admin/users/edit/<%= u.id %>" class="btn btn-sm btn-outline-secondary rounded-3" title="Editar usuario"><i class="bi bi-pencil-square me-1"></i> Editar</a>
                      <% if (Number(u.id) === Number(user.id)) { %>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3" disabled title="No puedes eliminar tu propia cuenta"><i class="bi bi-trash"></i></button>
                      <% } else { %>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3 btn-eliminar" data-bs-toggle="modal" data-bs-target="#modalEliminar" data-id="<%= u.id %>" data-nombre="<%= u.nombre %>" title="Eliminar usuario"><i class="bi bi-trash"></i></button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
        <div id="sinResultados" class="text-center text-secondary py-5 bg-white d-none">
          <i class="bi bi-search fs-1 d-block mb-2"></i>
          No hay usuarios que coincidan con los filtros.
        </div>
      <% } %>
    </section>

    <footer class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4 small text-secondary">
      <span><i class="bi bi-shield-check me-1"></i> Sesión activa como <strong><%= user.email %></strong></span>
      <a href="/" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Ir al sitio público</a>
    </footer>
  </main>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-labelledby="tituloEliminar" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <h2 class="modal-title fs-5 fw-bold" id="tituloEliminar">¿Eliminar usuario?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        Vas a eliminar permanentemente la cuenta de <strong id="nombreEliminar"></strong>.
        <p class="small text-danger mt-2 mb-0">Esta acción no se puede deshacer.</p>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
        <form id="formEliminar" method="POST" action="">
          <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        </form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Filtrado de tabla
  const buscar = document.getElementById('buscarUsuario');
  const filtrarRol = document.getElementById('filtrarRol');
  const filas = [...document.querySelectorAll('.fila-usuario')];
  const contadorVisibles = document.getElementById('contadorVisibles');
  const sinResultados = document.getElementById('sinResultados');

  function aplicarFiltros() {
    const texto = (buscar.value || '').trim().toLocaleLowerCase('es');
    const rol = filtrarRol.value;
    let visibles = 0;

    filas.forEach(fila => {
      const nombre = fila.querySelector('.nombre-usuario').textContent.toLocaleLowerCase('es');
      const correo = fila.querySelector('.correo-usuario').textContent.toLocaleLowerCase('es');
      const roles = (fila.dataset.roles || '').split('|');
      const mostrar = (nombre.includes(texto) || correo.includes(texto)) && (!rol || roles.includes(rol));
      fila.classList.toggle('d-none', !mostrar);
      if (mostrar) visibles++;
    });

    if (contadorVisibles) contadorVisibles.textContent = visibles;
    if (sinResultados) sinResultados.classList.toggle('d-none', visibles > 0);
  }

  if (buscar && filtrarRol) {
    buscar.addEventListener('input', aplicarFiltros);
    filtrarRol.addEventListener('change', aplicarFiltros);
  }

  // Modal eliminar
  document.querySelectorAll('.btn-eliminar').forEach(boton => {
    boton.addEventListener('click', () => {
      const id = boton.dataset.id;
      const nombre = boton.dataset.nombre;
      document.getElementById('nombreEliminar').textContent = nombre;
      document.getElementById('formEliminar').action = '/admin/users/delete/' + encodeURIComponent(id);
    });
  });

  // Resaltar automáticamente el enlace activo según la URL actual
  const rutaActual = window.location.pathname;
  document.querySelectorAll('.sidebar-nav a[href]').forEach(link => {
    if (link.getAttribute('href') === rutaActual) {
      document.querySelectorAll('.sidebar-nav .nav-link').forEach(el => el.classList.remove('active'));
      link.classList.add('active');
      const parentCollapse = link.closest('.collapse');
      if (parentCollapse) {
        parentCollapse.classList.add('show');
        const trigger = document.querySelector(`[href="#${parentCollapse.id}"]`);
        if (trigger) trigger.classList.remove('collapsed');
      }
    }
  });
</script>
</body>
</html>