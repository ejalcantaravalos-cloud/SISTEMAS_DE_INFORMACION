<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ZAVABA | Rentas</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/GestionRentas.css">
</head>

<body>
    <%
        // La sección la proporciona ContextoMenuRentas.js.
        const pantalla = typeof seccionRentas === 'string'
            ? seccionRentas
            : 'menu';

        const origenCaja = typeof origenMenuRentas === 'string'
            && ['general', 'eventos', 'inflables'].includes(origenMenuRentas)
            ? origenMenuRentas
            : 'inflables';

        const turnoAbierto = typeof caja !== 'undefined'
            && Boolean(caja && caja.turno_id);

        const menuInflables = '/rentas/gestion/inflables';
        const menuEventos = '/rentas/eventos';

        const regreso = pantalla === 'caja'
            ? (origenCaja === 'general'
                ? '/rentas'
                : origenCaja === 'eventos' ? menuEventos : menuInflables)
            : menuInflables;

        const etiquetaRegreso = regreso === '/rentas'
            ? 'Menú de rentas'
            : regreso === menuEventos ? 'Menú de eventos' : 'Menú de inflables';
    %>

    <!-- =====================================
         ENCABEZADO Y NAVEGACIÓN
    ====================================== -->

    <% if (pantalla === 'menu') { %>
        <nav class="hb-top py-3">
            <div class="container hb-main d-flex align-items-center justify-content-between gap-2">
                <a class="hb-brand" href="/rentas">ZABAVA / Rentas</a>
                <a class="btn btn-outline-light btn-sm" href="/logout">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Cerrar sesión
                </a>
            </div>
        </nav>
    <% } else { %>
        <%- include('partials/GestionRentasNav', {
            regreso,
            etiquetaRegreso
        }) %>
    <% } %>

    <main class="container hb-main py-5">

        <!-- AVISOS DEL CONTROLADOR DE CAJA -->

        <% if (typeof mensaje !== 'undefined' && mensaje) { %>
            <div class="alert alert-<%= typeof esError !== 'undefined' && esError ? 'warning' : 'success' %>" role="alert">
                <%= mensaje %>
            </div>
        <% } %>

        <% if (pantalla === 'menu') { %>

            <!-- =====================================
                 MENÚ GENERAL: TURNO Y TRES SERVICIOS
            ====================================== -->

            <header class="text-center mb-5">
                <p class="hb-kicker mb-2">Panel de trabajo</p>
                <h1 class="hb-heading">Selecciona un servicio</h1>
                <p class="hb-intro mx-auto mb-0">
                    Hola, <%= user?.nombre || 'Cajero' %>. ¿En qué área quieres trabajar?
                </p>
            </header>

            <!-- =====================================
                 INICIO DEL TURNO COMPARTIDO
            ====================================== -->

            <% if (!turnoAbierto) { %>

                <%- include('partials/TurnoCajaRentas', {
                    origenCaja: 'general',
                    caja: null,
                    cajas: typeof cajas !== 'undefined' ? cajas : [],
                    resumen: null
                }) %>

                <p class="text-secondary small mb-4">
                    Puedes consultar los servicios sin turno.
                    Para registrar cobros, abre primero tu caja.
                </p>

            <% } else { %>

                <section class="card tarjeta border-0 shadow-sm mb-4">

                    <div class="card-body d-flex flex-wrap
                                justify-content-between align-items-center gap-3">

                        <div>

                            <h2 class="h5 mb-2">
                                <i class="bi bi-wallet2 me-2"></i>
                                Mi turno de caja
                            </h2>

                            <span class="badge text-bg-success mb-2">
                                Turno abierto
                            </span>

                            <p class="mb-1">
                                <strong>Caja:</strong> <%= caja.caja_nombre %>
                            </p>

                            <p class="mb-0 text-secondary">
                                Turno #<%= caja.turno_id %> · Fondo inicial:
                                <%= Number(caja.fondo_inicial).toLocaleString('es-MX', {
                                    style: 'currency', currency: 'MXN'
                                }) %>
                            </p>

                        </div>

                        <a class="btn btn-outline-primary"
                           href="/rentas?seccion=caja&amp;origen=general">
                            Consultar o cerrar turno
                        </a>

                    </div>

                </section>

            <% } %>

            <!-- =====================================
                 ACCESO A LOS TRES SERVICIOS
            ====================================== -->

            <%
                const opciones = [
                    [
                        'Trampolines e inflables',
                        'Reservaciones, disponibilidad y operaciones de renta.',
                        'bi-balloon',
                        'rosa',
                        '/rentas/gestion/inflables'
                    ],
                    [
                        'Salones y eventos',
                        'Paquetes, reservaciones y calendario de eventos.',
                        'bi-house-door',
                        'morado',
                        '/rentas/eventos'
                    ],
                    [
                        'Restaurante',
                        'Gestión de comandas y servicio de alimentos.',
                        'bi-fork-knife',
                        'verde',
                        '/Cajero'
                    ]
                ];
            %>

            <div class="hb-home-menu mx-auto">
                <%- include('partials/GestionRentasMenu', { opciones }) %>
            </div>

        <% } else { %>

            <% if (pantalla === 'caja') { %>
                <header class="mb-4">
                    <p class="hb-kicker mb-2">Caja compartida</p>
                    <h1 class="hb-heading">Mi turno de caja</h1>
                    <p class="hb-intro">Abre, consulta o cierra tu turno de trabajo.</p>
                </header>

                <%- include('partials/TurnoCajaRentas', { origenCaja }) %>


            <% } else if (pantalla === 'pagos') { %>

                <header class="mb-4">
                    <p class="hb-kicker mb-2">Trampolines e inflables</p>
                    <h1 class="hb-heading">Pagos y anticipos</h1>
                    <p class="hb-intro">Consulta y liquida los saldos pendientes.</p>
                    <a class="btn btn-outline-primary" href="/rentas?seccion=caja&amp;origen=inflables">
                        <i class="bi bi-wallet2 me-1"></i> Mi turno de caja
                    </a>
                </header>
                <%- include('partials/PagosInflables') %>


            <% } else if (pantalla === 'cierres') { %>

                <header class="mb-4">
                    <p class="hb-kicker mb-2">Trampolines e inflables</p>
                    <h1 class="hb-heading">Cierre y revisión de reservaciones</h1>
                    <p class="hb-intro">Finaliza las rentas cuyo horario ya terminó.</p>
                    <a class="btn btn-outline-primary" href="/admin/inflables/caja?seccion=registrados">
                        <i class="bi bi-clipboard-check me-1"></i> Mis reservaciones
                    </a>
                </header>
                <%- include('partials/CierreInflables') %>

            <% } %>
        <% } %>

    </main>

    <footer class="hb-footer">
        ZABAVA · Gestión de rentas
    </footer>

</body>
</html>
