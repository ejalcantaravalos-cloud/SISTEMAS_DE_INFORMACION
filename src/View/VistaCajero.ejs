<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Toma de Órdenes - Caja</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/CajeroOrdenes.css" rel="stylesheet">
</head>
<body>

  <div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 px-2">
      <div>
        <h4 class="fw-semibold mb-0">Caja de Ordenes - Restaurante de comida rapida</h4>
        <small class="text-muted">Cajero activo: <%= user ? user.email : 'Caja Principal' %></small>
      </div>
      <div>
        <a href="/admin" class="btn btn-sm btn-outline-secondary">← Volver al Panel</a>
      </div>
    </div>
     <div style="display: flex; gap: 10px;">
       <a href="/ordenes/pedidos" class="btn-sm btn-primary" style="text-decoration: none;">Ver pedidos</a>
  </div>
    <div class="row g-3">
  
      <div class="col-lg-8">
        <div class="panel-caja p-3">
          <h6 class="fw-bold mb-3">Menú Disponible</h6>
          
          <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3">
            <% if (productos && productos.length > 0) { %>
              <% productos.forEach(p => { %>
                <div class="col">
                  <div class="card-platillo h-100 d-flex flex-column justify-content-between p-2">
                    <div>
                     
                      <div class="img-placeholder mb-2">
                        <% if (p.imagen_url) { %>
                          <img src="<%= p.imagen_url %>" alt="<%= p.nombre %>">
                        <% } else { %>
                          <span>Sin imagen</span>
                        <% } %>
                      </div>
                      
                      <div class="d-flex justify-content-between align-items-start">
                        <h6 class="fs-6 mb-1 text-truncate" title="<%= p.nombre %>"><%= p.nombre %></h6>
                        <% if (p.especial) { %>
                          <span class="badge bg-warning text-dark" style="font-size: 0.6rem;">★</span>
                        <% } %>
                      </div>
                      <span class="fw-bold text-success">$<%= Number(p.precio).toFixed(2) %></span>
                    </div>

                    
                    <div class="mt-2 pt-2 border-top">
                      <button type="button" 
                              class="btn btn-sm btn-primary w-100 btn-agregar" 
                              data-id="<%= p.id %>"
                              data-nombre="<%= p.nombre %>"
                              data-precio="<%= p.precio %>">
                        + Agregar
                      </button>
                    </div>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div class="col-12 text-center text-muted py-4">
                No hay platillos registrados o activos en el menú.
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="panel-caja p-3 orden-resumen">
          <h6 class="fw-bold mb-3 border-bottom pb-2">Detalles del Pedido</h6>

          <form id="formOrden" action="/ordenes/api/ordenes/crear" method="POST" onsubmit="prepararEnvio(event)">
            
            <div class="mb-3">
              <label class="form-label small fw-medium">Tipo de Orden:</label>
              <select class="form-select form-select-sm" name="tipo_orden" id="tipoOrden" onchange="toggleMesaField()">
                <option value="Mesa">Mesa (Consumo Local)</option>
                <option value="Para llevar">Para llevar</option>
              </select>
            </div>

            <div class="row g-2 mb-3">
              <div class="col-6" id="campoMesa">
                <label class="form-label small fw-medium">Número de Mesa:</label>
                <input type="number" name="numero_mesa" id="numeroMesa" class="form-control form-control-sm" placeholder="Ej. 4" required>
              </div>
              <div class="col-6" id="contenedorCliente">
                <label class="form-label small fw-medium">Nombre Cliente:</label>
                <input type="text" name="nombre_cliente" class="form-control form-control-sm" placeholder="Opcional">
              </div>
            </div>

            <label class="form-label small fw-medium">Alimentos Seleccionados:</label>
            <div id="listaProductos" class="mb-3 border rounded p-2 bg-light" style="min-height: 120px; max-height: 200px; overflow-y: auto;">
              <p class="text-muted text-center small mb-0 mt-3" id="mensajeVacio">Aún no se han agregado platillos.</p>
            </div>
            <input type="hidden" name="detalles" id="inputDetalles">

        
            <div class="mb-3">
              <label class="form-label small fw-medium">Notas / Modificaciones:</label>
              <textarea name="nota" class="form-control form-control-sm" rows="2" placeholder="Ej. Sin cebolla..."></textarea>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-3 pt-2 border-top">
              <span class="fw-bold">Total:</span>
              <span class="fs-5 fw-bold text-success" id="textoTotal">$0.00</span>
            </div>

            <button type="submit" class="btn btn-success w-100 py-2 fw-medium" id="btnGuardar" disabled>
              ✓ Registrar Orden
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>


  <script src="/js/cajero.js"></script>
</body>
</html>