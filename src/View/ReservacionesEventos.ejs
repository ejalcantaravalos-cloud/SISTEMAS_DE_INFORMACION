<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Reservaciones | HelpingBee</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Avisos.css">
    <style>
    :root {
        --hb-morado: #9062db;
        --hb-morado-oscuro: #7546c8;
        --hb-fondo: #f8f6fc;
        --hb-borde: #e7ddf5;
        --sidebar-ancho: 260px;
    }

    body {
        background: var(--hb-fondo);
        color: #303046;
    }

    @media (min-width: 992px) {
        .hb-sidebar {
            width: var(--sidebar-ancho) !important;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 1030;
        }

        .hb-contenido {
            margin-left: var(--sidebar-ancho);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
    }

    .hb-sidebar,
            .hb-sidebar.offcanvas-lg,
            .hb-barra-movil {
        background: linear-gradient(180deg, var(--hb-morado) 0%, var(--hb-morado-oscuro) 100%) !important;
        color: #ffffff !important;
    }

    .hb-nav .nav-link {
        color: rgba(255, 255, 255, 0.85) !important;
        border-radius: 0.65rem;
        padding: 0.58rem 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        transition: background-color 0.15s ease, color 0.15s ease;
    }

    .hb-nav .nav-link:hover {
        color: #ffffff !important;
        background-color: rgba(255, 255, 255, 0.15) !important;
    }

    .hb-nav .nav-link.active {
        color: var(--hb-morado-oscuro) !important;
        background-color: #ffffff !important;
        font-weight: 700;
    }

    .hb-subnav {
        padding-left: 0.9rem;
        margin-left: 0.8rem;
        border-left: 1px solid rgba(255, 255, 255, 0.25);
    }

    .hb-subnav .nav-link {
        padding: 0.4rem 0.75rem;
        font-size: 0.88rem;
    }

    .hb-etiqueta {
        font-size: 0.7rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.65);
        font-weight: 700;
        padding: 0 0.85rem;
    }

    .bloque {
        background: white;
        border: 1px solid var(--hb-borde);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 16px;
        box-shadow: 0 2px 10px rgba(117, 70, 200, 0.04);
    }

    .bloque h2 {
        font-size: 1.15rem;
        color: var(--hb-morado-oscuro);
        font-weight: 700;
        margin-bottom: 16px;
    }

    .btn-morado {
        background: var(--hb-morado);
        color: white;
        border: 0;
    }

    .btn-morado:hover {
        background: var(--hb-morado-oscuro);
        color: white;
    }

    .opcion {
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #eee5fc;
        padding: 10px 0;
    }

    .opcion input {
        width: 95px;
        margin-left: auto;
    }

    .color-mantel {
        width: 24px;
        height: 24px;
        border: 1px solid #aaa;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .total {
        color: var(--hb-morado-oscuro);
        font-size: 1.6rem;
        font-weight: 700;
    }

    [hidden] {
        display: none !important;
    }

    .bloque {
        scroll-margin-top: 18px;
    }

    .bloque h2 {
        display: flex;
        align-items: center;
        gap: .25rem;
    }

    .bloque:has(input:focus),.bloque:has(select:focus) {
        border-color: #c7b2ef;
    }

    .hb-sidebar .nav-link:focus-visible {
        outline: 2px solid white;
    }

    .hb-barra-movil {
        z-index: 1030;
    }

    .hb-sidebar.offcanvas-lg {
        --bs-offcanvas-width: 260px;
    }

    .bloque label {
        font-size: .9rem;
        font-weight: 600;
    }

    .bloque label input,.bloque label select,.bloque label textarea {
        margin-top: 5px;
        font-weight: 400;
    }

    .hb-contenido main {
        max-width: 1320px;
    }

    .hb-choice {
        min-height: 94px;
    }

    .hb-summary {
        z-index: 10;
    }

    .hb-sidebar {
        overflow-y: auto;
    }
</style>
    <link rel="stylesheet" href="/css/GestionRentas.css">
</head>
<body>

<!-- BARRA SUPERIOR EN MÓVIL / TABLET -->
<header class="navbar navbar-dark hb-barra-movil d-lg-none px-3 py-2 sticky-top shadow-sm">
    <div class="d-flex align-items-center justify-content-between w-100">
        <a class="navbar-brand fw-bold mb-0" href="/rentas/eventos">🐝 HelpingBee</a>
        <button class="btn btn-outline-light btn-sm rounded-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarBee" aria-controls="sidebarBee">
            <i class="bi bi-list fs-5"></i>
        </button>
    </div>
</header>

<!-- MENÚ LATERAL -->
<aside class="offcanvas-lg offcanvas-start hb-sidebar d-flex flex-column shadow" tabindex="-1" id="sidebarBee" aria-labelledby="sidebarBeeLabel">
    <div class="p-3 p-lg-4 border-bottom border-white border-opacity-15 d-flex align-items-center justify-content-between">
        <a class="navbar-brand d-flex align-items-center gap-2 text-white text-decoration-none" href="/rentas/eventos" id="sidebarBeeLabel">
            <span class="bg-white bg-opacity-20 rounded-3 px-2 py-1 fs-5">🐝</span>
            <div>
                <div class="fw-bold lh-1 fs-5">HelpingBee</div>
                <small class="text-white-50" style="font-size: 0.75rem;">Reservaciones</small>
            </div>
        </a>
        <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebarBee" aria-label="Cerrar menú">
        </button>
    </div>

    <div class="p-3 flex-grow-1 overflow-y-auto hb-nav">
        <div class="hb-etiqueta mb-2">Navegación</div>
        <ul class="nav flex-column gap-1 mb-4">
            <li class="nav-item">
                <a class="nav-link active" href="/rentas/eventos/reservaciones">
                    <i class="bi bi-calendar-plus"></i>
                    <span>Nueva reservación</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/rentas/gestion/eventos/calendario"><i class="bi bi-calendar-week"></i><span>Disponibilidad</span></a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/rentas/eventos/reservaciones/historial">
                    <i class="bi bi-clock-history"></i>
                    <span>Mis reservaciones</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/rentas/eventos">
                    <i class="bi bi-balloon"></i>
                    <span>Eventos</span>
                </a>
            </li>
        </ul>

        <div class="hb-etiqueta mb-2">Secciones</div>
        <ul class="nav flex-column gap-1 hb-subnav">
            <li class="nav-item"><a class="nav-link" href="#secCliente">1. Cliente y evento</a></li>
            <li class="nav-item"><a class="nav-link" href="#fechaHorario">2. Paquete y horario</a></li>
            <li class="nav-item"><a class="nav-link" href="#secSalon">3. Salón</a></li>
            <li class="nav-item"><a class="nav-link" href="#secInflable">4. Trampolín o inflable</a></li>
            <li class="nav-item"><a class="nav-link" href="#secExtras">5. Comida y extras</a></li>
            <li class="nav-item"><a class="nav-link" href="#secCotizacion">8. Cotización</a></li>
        </ul>
    </div>

    <div class="p-3 border-top border-white border-opacity-15">
        <a class="btn btn-outline-light btn-sm w-100 rounded-3" href="/rentas/eventos">
            <i class="bi bi-arrow-left me-1"></i> Regresar a eventos
        </a>
    </div>
</aside>

<!-- CONTENIDO PRINCIPAL -->
<div class="hb-contenido">
    <main class="container py-4 flex-grow-1">
        <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div>
                <p class="hb-kicker mb-1">Eventos / Contratación</p>
                <h1 class="hb-heading mb-0">Nueva reservación</h1>
            </div>
            <a class="btn btn-outline-secondary" href="/rentas/eventos/reservaciones/historial"><i class="bi bi-clock-history"></i> Mis reservaciones</a>
        </div>
        <p class="text-muted">Consulta disponibilidad, personaliza el evento y genera la cotización.</p>
        <div id="mensaje" class="alert" role="alert" hidden></div>

        <form id="formReserva">
            <div class="row g-3">
                <div class="col-lg-8">
                    <section class="bloque" id="secCliente">
                        <h2><span class="hb-section-number">1</span>Cliente y evento</h2>
                        <div class="row g-3">
                            <label class="col-12">Cliente registrado (opcional)<select name="cliente_id" class="form-select">
                                <option value="">Registrar cliente nuevo</option>
                                <% clientes.forEach(c=>{ %><option value="<%= c.id %>" data-nombre="<%= c.nombre %>" data-telefono="<%= c.telefono||'' %>" data-email="<%= c.email||'' %>"><%= c.nombre %> — <%= c.telefono||'Sin teléfono' %> (#<%= c.id %>)</option><% }); %>
                            </select></label>
                            <label class="col-md-6">Nombre del cliente<input class="form-control" name="cliente" maxlength="120" required>
                            </label>
                            <label class="col-md-6">Teléfono<input class="form-control" name="telefono" maxlength="30" required>
                            </label>
                            <label class="col-md-6">Correo (opcional)<input class="form-control" name="email" type="email" maxlength="150">
                            </label>
                            <label class="col-md-6">Nombre del evento<input class="form-control" name="evento" maxlength="150" required>
                            </label>
                            <label class="col-md-6">Tipo de evento<input class="form-control" name="tipo_evento" maxlength="80" placeholder="Cumpleaños, reunión..." required>
                            </label>
                            <label class="col-md-6">Invitados<input class="form-control" name="invitados" type="number" min="1" max="10000" step="1" value="30" required>
                            </label>
                            <label class="col-12">
                                <input class="form-check-input" name="menores" type="checkbox" value="1"> Asistirán menores de edad (deben estar acompañados por adultos).</label>
                            <label class="col-12">Observaciones<textarea class="form-control" name="observaciones" maxlength="4000" rows="2"></textarea>
                            </label>
                        </div>
                    </section>

                    <section class="bloque" id="fechaHorario">
                        <h2><span class="hb-section-number">2</span>Paquete, fecha y horario</h2>
                        <div class="row g-3">
                            <label class="col-12">Paquete<select class="form-select" name="paquete_id" required>
                                <option value="">Selecciona un paquete</option>
                                <option value="personalizado" <%= personalizado ? 'selected' : '' %>>Personalizado — armar mi evento</option>
                                <% paquetes.forEach(p=>{ %><option value="<%= p.id %>"><%= p.nombre %> — <%= p.tipo %></option><% }); %>
                            </select></label>
                            <div class="col-12">
                                <button type="button" id="personalizar" class="btn btn-outline-primary"><i class="bi bi-sliders"></i> Personalizado: armar evento</button>
                                <p id="modoPersonalizado" class="alert alert-info mt-2 mb-0" hidden>Personalizado seleccionado. Indica la fecha y las horas, consulta disponibilidad y elige los servicios. No se creará un paquete de catálogo.</p>
                            </div>
                            <label class="col-md-4">Fecha del evento<input type="date" class="form-control" name="fecha_evento" required>
                            </label>
                            <label class="col-md-4">Hora de inicio<input type="time" class="form-control" name="hora_inicio" required>
                            </label>
                            <label class="col-md-4">Hora de fin<input type="time" class="form-control" name="hora_fin" required>
                            </label>
                            <small class="text-muted">El evento comienza y termina en la misma fecha.</small>
                            <div class="col-12">
                                <button type="button" id="consultar" class="btn btn-morado">Consultar disponibilidad</button>
                            </div>
                        </div>
                    </section>

                    <p id="estadoDisponibilidad" class="alert alert-light border">Selecciona el paquete, la fecha y el horario para cargar los salones y trampolines.</p>

                    <fieldset id="seleccion" disabled>
                        <section class="bloque" id="secSalon">
                            <h2><span class="hb-section-number">3</span>Salón</h2>
                            <label class="d-block mb-3">Salón<select class="form-select" name="salon_id" required>
                                <option value="">Consulta disponibilidad primero</option>
                            </select>
                            </label>
                            <small class="text-muted" id="infoSalon"></small>
                        </section>

                        <section class="bloque" id="secInflable">
                            <h2><span class="hb-section-number">4</span>Trampolín o inflable</h2>
                            <p class="text-muted">Selecciona primero el salón. Los juegos ocupados o que no caben se muestran bloqueados.</p>
                            <label class="d-block">Trampolín / inflable<select class="form-select" name="inflable_id" required>
                                <option value="">Consulta disponibilidad primero</option>
                            </select>
                            </label>
                            <div id="avisoTarifa" class="alert alert-warning mt-2" hidden></div>
                            <div id="listaInflables" class="row g-2 mt-2"></div>
                        </section>

                        <fieldset id="extras" hidden disabled>
                            <section class="bloque" id="secExtras">
                                <h2><span class="hb-section-number">5</span>Comida</h2>
                                <p class="text-muted" id="infoComida"></p>
                                <label class="d-block">Menú para la fecha del evento<select class="form-select" name="menu_id">
                                </select>
                                </label>
                                <div id="comida"></div>
                            </section>
                            <section class="bloque">
                                <h2><span class="hb-section-number">6</span>Manteles</h2>
                                <p id="infoManteles" class="text-muted"></p>
                                <div id="manteles"></div>
                            </section>
                            <section class="bloque">
                                <h2><span class="hb-section-number">7</span>Sonido y meseros</h2>
                                <div id="sonidos"></div>
                                <fieldset id="meserosEditables" class="mt-3" hidden disabled>
                                    <div class="row g-3">
                                        <label class="col-md-6">Cantidad de meseros<input type="number" name="meseros" class="form-control" min="0" max="10000" step="1" value="0" required>
                                        </label>
                                        <label class="col-md-6">Tarifa por mesero ($)<input type="number" name="tarifa_mesero" class="form-control" min="0" step="0.01" value="0" required>
                                        </label>
                                    </div>
                                    <small class="text-muted">Tarifa manual acordada con el cliente.</small>
                                </fieldset>
                                <p id="meserosFijos" class="mt-3 mb-0"></p>
                            </section>
                        </fieldset>
                    </fieldset>
                </div>

                <div class="col-lg-4" id="secCotizacion">
                    <section class="bloque hb-summary sticky-lg-top" style="top:16px">
                        <h2><span class="hb-section-number">8</span>Cotización</h2>
                        <p class="text-muted">Consulta disponibilidad y selecciona los servicios.</p>
                        <div id="resultado"></div>
                        <button type="button" id="cotizar" class="btn btn-morado w-100 mb-2" disabled>Calcular cotización</button>
                        <button type="submit" id="guardar" class="btn btn-success w-100" disabled>Registrar reservación</button>
                        <input type="hidden" name="total_esperado" value="">
                        <small class="text-muted d-block mt-2">Registrar no significa que el anticipo ya fue cobrado.</small>
                    </section>
                </div>
            </div>
        </form>
    </main>
</div>

<%- include('partials/Aviso') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
const RUTA = '/rentas/eventos/reservaciones';
const form = document.querySelector('#formReserva'), campo = n => form.elements.namedItem(n), el = id => document.getElementById(id);
const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const dinero = n => Number(n).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
let catalogo = null, revision = 0, guardando = false;
function mensaje(t, error = true) {
    el('mensaje').hidden = !t;
    el('mensaje').className = 'alert ' + (error ? 'alert-danger' : 'alert-success');
    el('mensaje').textContent = t;
    if (t && error)
        el('mensaje').scrollIntoView({ block: 'center' });
}
function invalidar() {
    revision++;
    campo('total_esperado').value = '';
    el('guardar').disabled = true;
    el('resultado').innerHTML = '';
}
function mostrar(id, si) {
    el(id).hidden = !si;
    el(id).disabled = !si;
}
function modalidad() {
    const personal = campo('paquete_id').value === 'personalizado';
    el('modoPersonalizado').hidden = !personal;
    el('personalizar').classList.toggle('active', personal);
    el('personalizar').setAttribute('aria-pressed', String(personal));
    if (!catalogo) {
        mostrar('extras', personal);
        mostrar('meserosEditables', personal);
    }
}
function reiniciarDisponibilidad() {
    invalidar();
    catalogo = null;
    el('seleccion').hidden = false;
    el('seleccion').disabled = true;
    el('estadoDisponibilidad').hidden = false;
    el('estadoDisponibilidad').textContent = 'Consulta disponibilidad para seleccionar los recursos del evento.';
    for (const n of ['salon_id', 'inflable_id', 'menu_id'])
        campo(n).innerHTML = '<option value="">Consulta disponibilidad primero</option>';
    for (const id of ['listaInflables', 'comida', 'manteles', 'sonidos', 'meserosFijos', 'infoSalon', 'infoComida', 'infoManteles'])
        el(id).textContent = '';
    el('avisoTarifa').hidden = true;
    el('cotizar').disabled = true;
    modalidad();
}
function opciones(select, items, etiqueta, inhabilitado = () => false) {
    select.innerHTML = '<option value="">Selecciona</option>' + items.map(x => `<option value="${Number(x.id)}" ${inhabilitado(x) ? 'disabled' : ''}>${esc(etiqueta(x))}</option>`).join('');
}
function cabe(s, i) {
    if (!s)
        return false;
    const sl = Number(s.largo_m), sa = Number(s.ancho_m), sh = Number(s.alto_m), il = Number(i.largo_m), ia = Number(i.ancho_m), ih = Number(i.alto_m);
    return [sl, sa, sh, il, ia, ih].every(n => n > 0 && Number.isFinite(n)) && ih <= sh && ((il <= sl && ia <= sa) || (il <= sa && ia <= sl));
}
function tienePrecioInflable(i) {
    const v = i.precio_completo;
    return v != null && String(v).trim() !== '' && Number.isFinite(Number(v)) && Number(v) >= 0;
}
function precioInflable(i) {
    return tienePrecioInflable(i) ? dinero(i.precio_completo) : 'Precio no configurado en el catálogo';
}
function actualizarInflables() {
    const s = catalogo.salones.find(x => Number(x.id) === Number(campo('salon_id').value));
    opciones(campo('inflable_id'), catalogo.inflables, i => i.nombre + (Number(i.ocupado) ? ' — Ocupado' : !cabe(s, i) ? ' — No compatible' : ' — ' + precioInflable(i)), i => Number(i.ocupado) || !cabe(s, i) || !tienePrecioInflable(i));
    el('listaInflables').innerHTML = catalogo.inflables.map(i => {
        const ocupado = Number(i.ocupado) !== 0, compatible = cabe(s, i), libre = !ocupado && compatible && tienePrecioInflable(i);
        const estado = ocupado ? 'Ocupado en este horario' : !s ? 'Elige salón' : !compatible ? 'No compatible (dimensiones)' : !tienePrecioInflable(i) ? 'Precio no configurado' : 'Disponible';
        return `<div class="col-md-6"><button type="button" data-inflable="${Number(i.id)}" class="btn btn-outline-secondary hb-choice text-start w-100 h-100" aria-pressed="false" ${libre ? '' : 'disabled'}>
            <strong>${esc(i.nombre)}</strong><br><small class="${libre ? 'text-success' : 'text-muted'}">${estado}</small><br><small>${esc(precioInflable(i))}</small></button></div>`;
    }).join('') || '<p class="text-muted">No hay trampolines o inflables activos.</p>';
    el('infoSalon').textContent = s ? `Capacidad: ${s.capacidad}. ${s.horas_incluidas} horas incluidas. Depósito: ${dinero(s.deposito_limpieza)}.` : 'Selecciona primero el salón.';
}
function fila(x, nombre, max) {
    const precio = nombre === 'comida' ? x.precio_base : x.precio_renta;
    const color = /^#[0-9a-f]{6}$/i.test(x.codigo_color || '') ? `<span class="color-mantel" style="background:${x.codigo_color}"></span>` : '';
    return `<label class="opcion">${color}<span>${esc(x.nombre)} ${esc(x.color || '')} ${esc(x.forma || '')} ${esc(x.medidas || '')}<small class="d-block text-muted">${dinero(precio)}${nombre !== 'comida' ? ' · ' + Number(max) + ' disponibles' : ''}</small></span><input aria-label="Cantidad de ${esc(x.nombre)}" type="number" class="form-control" name="${nombre}[p_${Number(x.id)}]" min="0" max="${Number(max)}" step="1" value="0" required></label>`;
}
function actualizarComida() {
    const id = Number(campo('menu_id').value);
    el('comida').innerHTML = catalogo.productos.filter(x => Number(x.menu_id) === id).map(x => fila(x, 'comida', 10000)).join('') || '<p class="text-muted mt-2">Selecciona un menú con platillos disponibles.</p>';
}
function cargar(a) {
    catalogo = a;
    const p = a.paquete, preparado = p.tipo === 'preparado', personalizado = p.tipo === 'personalizado';
    mostrar('seleccion', true);
    el('estadoDisponibilidad').hidden = true;
    el('avisoTarifa').hidden = !a.avisoTarifa;
    el('avisoTarifa').textContent = a.avisoTarifa || '';
    mostrar('extras', preparado || personalizado);
    mostrar('meserosEditables', personalizado);
    const invitados = Number(campo('invitados').value);
    const capacidad = s => invitados >= Number(p.min_invitados) && invitados <= Number(s.capacidad) && (p.max_invitados == null || invitados <= Number(p.max_invitados));
    opciones(campo('salon_id'), a.salones, s => s.nombre + (Number(s.ocupado) ? ' — Ocupado' : !capacidad(s) ? ' — Capacidad incompatible' : ' — ' + dinero(s.tarifa_base)), s => Number(s.ocupado) || !capacidad(s));
    actualizarInflables();
    opciones(campo('menu_id'), a.menus, m => m.nombre);
    campo('menu_id').required = preparado;
    actualizarComida();
    el('infoComida').textContent = preparado ? `${p.porciones_incluidas} porciones incluidas; hasta ${dinero(p.valor_porcion_incluida)} por porción.` : 'Comida opcional, a precio de catálogo.';
    el('infoManteles').textContent = preparado ? `${p.manteles_incluidos} manteles incluidos. Elige colores y cantidades.` : 'Manteles opcionales, a precio de renta.';
    el('manteles').innerHTML = a.manteles.filter(x => Number(x.disponibles) > 0).map(x => fila(x, 'manteles', x.disponibles)).join('') || '<p class="text-muted">No hay manteles disponibles.</p>';
    el('sonidos').innerHTML = preparado ? a.sonidoIncluido.map(x => {
        const s = a.sonidos.find(y => Number(y.id) === Number(x.id));
        return `<p>${Number(x.cantidad)} × ${esc(s?.nombre || 'Equipo inactivo')} ${!s || Number(s.disponibles) < Number(x.cantidad) ? '<strong class="text-danger">No disponible</strong>' : '(incluido)'}</p>`;
    }).join('') || '<p>Sin sonido incluido.</p>' : a.sonidos.filter(x => Number(x.disponibles) > 0).map(x => fila(x, 'sonidos', x.disponibles)).join('') || '<p>Sin equipos disponibles.</p>';
    el('meserosFijos').textContent = preparado ? `${p.cantidad_meseros} meseros incluidos.` : '';
    el('cotizar').disabled = false;
}
async function peticion(url, datos) {
    const r = await fetch(RUTA + url, datos ? { method: 'POST', body: datos } : { cache: 'no-store' });
    const tipo = r.headers.get('content-type') || '';
    if (!tipo.includes('application/json'))
        throw new Error(`El servidor respondió con una página en lugar de datos (HTTP ${r.status}). Revisa sesión, ruta y consola de Docker.`);
    const j = await r.json();
    if (!r.ok)
        throw new Error(j.error || 'No se pudo completar la operación.');
    return j;
}
['paquete_id', 'fecha_evento', 'hora_inicio', 'hora_fin', 'invitados'].forEach(n => campo(n).addEventListener('change', reiniciarDisponibilidad));
form.addEventListener('input', invalidar);
el('personalizar').addEventListener('click', () => {
    campo('paquete_id').value = 'personalizado';
    reiniciarDisponibilidad();
    mensaje('');
    const faltante = ['fecha_evento', 'hora_inicio', 'hora_fin', 'invitados'].map(campo).find(x => !x.checkValidity());
    if (!faltante)
        el('consultar').click();
    else {
        faltante.focus();
        faltante.reportValidity();
    }
});
el('listaInflables').addEventListener('click', e => {
    const boton = e.target.closest('button[data-inflable]');
    if (!boton || boton.disabled)
        return;
    campo('inflable_id').value = boton.dataset.inflable;
    marcarInflable();
    invalidar();
    campo('inflable_id').focus();
});
function marcarInflable() {
    el('listaInflables').querySelectorAll('[data-inflable]').forEach(b => {
        const activo = b.dataset.inflable === campo('inflable_id').value;
        b.classList.toggle('active', activo);
        b.setAttribute('aria-pressed', String(activo));
    });
}
campo('inflable_id').addEventListener('change', marcarInflable);
campo('cliente_id').addEventListener('change', () => {
    const o = campo('cliente_id').selectedOptions[0], existe = Boolean(o.value);
    for (const [n, k] of [['cliente', 'nombre'], ['telefono', 'telefono'], ['email', 'email']]) {
        campo(n).value = existe ? o.dataset[k] || '' : '';
        campo(n).readOnly = existe;
        if (n !== 'email')
            campo(n).required = !existe;
    }
    invalidar();
});
campo('salon_id').addEventListener('change', () => {
    if (catalogo)
        actualizarInflables();
    invalidar();
});
campo('menu_id').addEventListener('change', () => {
    if (catalogo)
        actualizarComida();
    invalidar();
});
el('consultar').addEventListener('click', async () => {
    mensaje('');
    reiniciarDisponibilidad();
    const params = new URLSearchParams();
    for (const n of ['paquete_id', 'fecha_evento', 'hora_inicio', 'hora_fin', 'invitados']) {
        if (!campo(n).reportValidity())
            return;
        params.set(n, campo(n).value);
    }
    if (campo('hora_fin').value <= campo('hora_inicio').value) {
        mensaje('La hora de fin debe ser posterior al inicio, el mismo día.');
        return;
    }
    const rev = revision;
    el('consultar').disabled = true;
    el('estadoDisponibilidad').textContent = 'Consultando salones, trampolines y servicios...';
    try {
        const a = await peticion('/disponibilidad?' + params);
        if (rev === revision) {
            cargar(a);
            mensaje('Disponibilidad consultada. Selecciona un salón y luego un trampolín.', false);
        }
    }
    catch (e) {
        if (rev === revision) {
            mensaje(e.message);
            el('estadoDisponibilidad').textContent = 'No se pudo consultar. Corrige el error e inténtalo nuevamente.';
        }
    }
    finally {
        el('consultar').disabled = false;
    }
});
el('cotizar').addEventListener('click', async () => {
    if (!catalogo || !form.reportValidity())
        return;
    mensaje('');
    invalidar();
    const rev = revision;
    el('cotizar').disabled = true;
    try {
        const q = await peticion('/cotizar', new URLSearchParams(new FormData(form)));
        if (rev !== revision)
            return;
        const sumar = a => a.reduce((n, x) => n + x.importe, 0);
        const renglones = [['Salón', q.salon], ['Inflable', q.inflable], ['Paquete', q.paquete], ['Comida adicional', sumar(q.comida)], ['Manteles adicionales', sumar(q.manteles)], ['Sonido adicional', sumar(q.sonidos)], ['Meseros adicionales', q.meseros * q.tarifaMesero]];
        el('resultado').innerHTML = renglones.map(([n, v]) => `<div class="d-flex justify-content-between mb-2"><span>${n}</span><strong>${dinero(v / 100)}</strong></div>`).join('') +
            `<hr><div>Total del servicio</div><div class="total">${dinero(q.total / 100)}</div><div>Anticipo (50%): <strong>${dinero(q.anticipo / 100)}</strong></div><div>Depósito de limpieza: <strong>${dinero(q.deposito / 100)}</strong></div><div class="mt-2">Total con depósito: <strong>${dinero((q.total + q.deposito) / 100)}</strong></div><hr>`;
        campo('total_esperado').value = q.total + q.deposito;
        el('guardar').disabled = false;
    }
    catch (e) {
        mensaje(e.message);
    }
    finally {
        el('cotizar').disabled = !catalogo;
    }
});
form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (guardando || campo('total_esperado').value === '' || !form.reportValidity())
        return;
    if (!confirm('¿Registrar la reservación? El anticipo quedará pendiente de cobro.'))
        return;
    const datos = new URLSearchParams(new FormData(form));
    guardando = true;
    el('guardar').disabled = true;
    el('cotizar').disabled = true;
    try {
        const r = await peticion('/crear', datos);
        window.location.assign(r.ruta);
    }
    catch (err) {
        mensaje(err.message);
        invalidar();
        el('mensaje').scrollIntoView({ block: 'center' });
    }
    finally {
        guardando = false;
        el('cotizar').disabled = !catalogo;
    }
});
const prefill = new URLSearchParams(location.search);
for (const n of ['fecha_evento', 'hora_inicio', 'hora_fin']) {
    const valor = prefill.get(n);
    if (valor)
        campo(n).value = valor;
}
reiniciarDisponibilidad();

</script>
</body>
</html>