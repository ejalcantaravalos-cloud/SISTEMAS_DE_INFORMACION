<section class="card tarjeta mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="h4 mb-0">Turno de caja</h2>
            <% if (caja && caja.turno_id) { %>
                <span class="badge text-bg-success">Turno abierto</span>
            <% } else { %>
                <span class="badge text-bg-secondary">Sin turno abierto</span>
            <% } %>
        </div>

        <% if (caja) { %>
            <p class="mb-1"><strong>Caja:</strong> <%= caja.caja_nombre %></p>
            <p class="mb-1"><strong>Abierta por:</strong> <%= caja.nombre_cajero %></p>
            <p class="mb-1"><strong>Turno:</strong> #<%= caja.turno_id %></p>
            <p class="mb-3"><strong>Fondo inicial:</strong> $<%= Number(caja.fondo_inicial).toFixed(2) %> MXN</p>
            <% if (resumen) { %>
                <div class="row g-2 mb-3">
                    <% for (const [etiqueta, campo] of [
                        ['Cobrado en efectivo', 'pagos_efectivo'],
                        ['Cobrado con tarjeta', 'pagos_tarjeta'],
                        ['Cobrado por transferencia', 'pagos_transferencia'],
                        ['Total cobrado', 'total_cobrado']
                    ]) { %>
                        <div class="col-6 col-md-3"><div class="border rounded p-2">
                            <div class="small text-secondary"><%= etiqueta %></div>
                            <strong>$<%= Number(resumen[campo]).toFixed(2) %></strong>
                        </div></div>
                    <% } %>
                </div>
                <p class="fw-bold">Efectivo esperado: $<%= Number(resumen.efectivo_esperado).toFixed(2) %> MXN</p>
                <form action="/rentas/turnos/cerrar" method="POST" class="row g-3"
                      onsubmit="return confirm('¿Registrar corte y cerrar tu turno?');">
                    <input type="hidden" name="origen_menu_rentas" value="<%= origenCaja %>">
                    <input type="hidden" name="turno_id" value="<%= caja.turno_id %>">
                    <div class="col-md-4">
                        <label class="form-label" for="efectivo_contado">Efectivo contado (MXN)</label>
                        <input class="form-control" id="efectivo_contado" name="efectivo_contado"
                               type="number" min="0" max="9999999999.99" step="0.01" required>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="observaciones">Observaciones (opcional)</label>
                        <input class="form-control" id="observaciones" name="observaciones" maxlength="1000">
                    </div>
                    <div><button class="btn btn-outline-danger" type="submit">Realizar corte y cerrar caja</button></div>
                </form>
            <% } else { %>
                <p class="alert alert-warning">No se pudo consultar el resumen del turno.</p>
            <% } %>
        <% } else if (Array.isArray(cajas) && cajas.length) { %>
            <p class="text-secondary">Selecciona tu caja para cobrar en cualquier servicio.</p>
            <form action="/rentas/turnos/abrir" method="POST" class="row g-3 align-items-end">
                <input type="hidden" name="origen_menu_rentas" value="<%= origenCaja %>">
                <div class="col-sm-6 col-md-4">
                    <label class="form-label" for="caja_id">Caja disponible</label>
                    <select id="caja_id" name="caja_id" class="form-select" required>
                        <option value="">Selecciona una caja</option>
                        <% cajas.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.nombre %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-sm-6 col-md-4">
                    <label class="form-label" for="fondo_inicial">Fondo inicial (MXN)</label>
                    <input id="fondo_inicial" name="fondo_inicial" type="number"
                           min="0" max="9999999999.99" step="0.01"
                           value="0.00" required class="form-control">
                </div>
                <div class="col-sm-auto">
                    <button class="btn btn-success" type="submit">Abrir turno</button>
                </div>
            </form>
        <% } else { %>
            <div class="alert alert-warning mb-0">No hay cajas disponibles en este momento.</div>
        <% } %>
    </div>
</section>
