<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Gestión de inflables | HelpingBee</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/GestionRentas.css">
</head>

<body>

    <!-- NAVEGACIÓN -->

    <%- include('partials/GestionRentasNav', {
        regreso: '/rentas',
        etiquetaRegreso: 'Menú de rentas'
    }) %>

    <main class="container hb-main py-5">

        <div class="hb-crumb mb-3">
            <a href="/rentas">Rentas</a> / Trampolines e inflables
        </div>

        <header class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <p class="hb-kicker mb-2">Área de rentas</p>
                <h1 class="hb-heading mb-2">Gestión de inflables</h1>
                <p class="hb-intro mb-0">Selecciona la operación que necesitas realizar.</p>
            </div>

            <a class="btn btn-outline-primary" href="/rentas?seccion=caja&amp;origen=inflables">
                <i class="bi bi-wallet2 me-1"></i>
                Mi turno de caja
            </a>
        </header>

        <!-- OPCIONES DEL MÓDULO -->

        <%
            const opciones = [
                [
                    "Nueva reservación",
                    "Selecciona un juego y registra los datos de la renta.",
                    "bi-calendar-plus",
                    "morado",
                    "/admin/inflables/caja?seccion=nueva"
                ],

                [
                    "Disponibilidad",
                    "Consulta el calendario y los horarios disponibles.",
                    "bi-calendar-week",
                    "azul",
                    "/admin/inflables/caja?seccion=disponibilidad"
                ],

                [
                    "Mis reservaciones",
                    "Consulta el historial de reservaciones.",
                    "bi-clipboard-check",
                    "verde",
                    "/admin/inflables/caja?seccion=registrados"
                ],

                [
                    "Pagos y anticipos",
                    "Consulta y liquida los saldos pendientes.",
                    "bi-wallet2",
                    "amarillo",
                    "/rentas?seccion=pagos"
                ],

                [
                    "Cierre y revisión",
                    "Finaliza las rentas cuyo horario ya terminó.",
                    "bi-check2-circle",
                    "rosa",
                    "/rentas?seccion=cierres"
                ],

                [
                    "Cancelaciones",
                    "Cancela servicios y consulta los motivos registrados.",
                    "bi-calendar-x",
                    "rojo",
                    "/rentas/cancelaciones/inflables"
                ]
            ];
        %>

        <%- include('partials/GestionRentasMenu', { opciones }) %>

    </main>

    <footer class="hb-footer">
        HelpingBee · Gestión de rentas
    </footer>

</body>
</html>
