<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pendientes de pago | ZABAVA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/Avisos.css">
    <style>
        body {
            background: #f8f7fc;
            color: #292436;
        }
        .barra {
            background: #4d326d;
            color: white;
        }
        .panel {
            border: 1px solid #e7e1ee;
            border-radius: 1rem;
            background: white;
        }
        .btn-morado {
            background: #67438d;
            color: white;
            border-color: #67438d;
        }
        .btn-morado:hover, .btn-morado:focus {
            background: #4d326d;
            color: white;
            border-color: #4d326d;
        }
    </style>
</head>
<body>
    <%
        const dinero = importe => Number(importe || 0).toLocaleString('es-MX', {
            style: 'currency', currency: 'MXN'
        });
        const fechaLocal = fecha => {
            const f = new Date(fecha);
            return !fecha || Number.isNaN(f.getTime()) ? '—' : f.toLocaleString('es-MX');
        };
    %>
    <nav class="barra py-3">
        <div class="container d-flex align-items-center justify-content-between flex-wrap gap-3">
            <strong><i class="bi bi-cash-coin me-2"></i>ZABAVA · Caja restaurante</strong>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-light" href="/ordenes/pedidos">Ver todos los pedidos</a>
                <a class="btn btn-sm btn-light" href="/ordenes/caja">Volver a caja</a>
            </div>
        </div>
    </nav>

    <main class="container py-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">Pedidos pendientes de pago</h1>
                <p class="text-secondary mb-0">Tus órdenes con saldo pendiente, incluso si ya fueron entregadas o son de un turno anterior.</p>
            </div>
            <a class="btn btn-outline-secondary" href="/ordenes/pedidos/pendientes-pago">
                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
            </a>
        </div>

        <% if (errorConsulta) { %>
            <div class="alert alert-danger" role="alert">No se pudo consultar el listado. Intenta actualizar la página.</div>
        <% } else if (!pedidos.length) { %>
            <div class="panel p-5 text-center">
                <i class="bi bi-check-circle fs-1 text-success"></i>
                <h2 class="h5 mt-3">No tienes pedidos pendientes de pago</h2>
                <p class="text-secondary mb-0">Aquí aparecerán tus pedidos cuando tengan un saldo por cobrar.</p>
            </div>
        <% } else { %>
            <section class="panel p-3 p-md-4">
                <h2 class="h5 fw-bold mb-3">Por cobrar (<%= pedidos.length %>)</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Pedido / fecha</th>
                                <th scope="col">Cliente / referencia</th>
                                <th scope="col">Estado de cocina</th>
                                <th scope="col" class="text-end">Total</th>
                                <th scope="col" class="text-end">Pagado</th>
                                <th scope="col" class="text-end">Pendiente</th>
                                <th scope="col" class="text-end">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% pedidos.forEach(p => { %>
                                <tr>
                                    <td>
                                        <strong>#<%= p.id %></strong>
                                        <div class="small text-secondary"><%= fechaLocal(p.fecha_pedido) %></div>
                                    </td>
                                    <td>
                                        <strong><%= p.cliente_registrado || p.nombre_referencia || 'Sin nombre' %></strong>
                                        <% if (p.nombre_referencia && p.nombre_referencia !== p.cliente_registrado) { %>
                                            <div class="small text-secondary"><%= p.nombre_referencia %></div>
                                        <% } %>
                                        <div class="small text-secondary"><%= p.tipo_entrega === 'EN_LOCAL' ? 'Consumo en mesa' : p.tipo_entrega === 'PARA_LLEVAR' ? 'Para llevar' : 'Evento' %></div>
                                    </td>
                                    <td><span class="badge text-bg-secondary"><%= p.estado %></span></td>
                                    <td class="text-end text-nowrap"><%= dinero(p.total) %></td>
                                    <td class="text-end text-nowrap"><%= dinero(p.total_pagado) %></td>
                                    <td class="text-end text-nowrap fw-bold text-danger"><%= dinero(p.saldo_pendiente) %></td>
                                    <td class="text-end">
                                        <a class="btn btn-sm btn-morado text-nowrap" href="/ordenes/cobro/<%= p.id %>">
                                            <i class="bi bi-cash me-1"></i> Cobrar
                                        </a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </section>
        <% } %>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%- include('partials/Aviso') %>
</body>
</html>
