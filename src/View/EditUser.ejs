<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Editar usuario | Sistema Integral</title>

  <!-- Misma versión de Bootstrap e iconos que AdminVista.ejs -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    :root {
      --violeta: #7048c6;
      --violeta-oscuro: #5734a4;
      --fondo: #f6f5fa;
      --tinta: #252339;
    }
    body {
      background: var(--fondo);
      color: var(--tinta);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    .navbar-panel { background: #211b38; }
    .navbar-brand { font-weight: 750; letter-spacing: -.025em; }
    .navbar-panel .nav-link {
      color: #d9d4e8;
      border-radius: .65rem;
      padding: .55rem .8rem !important;
    }
    .navbar-panel .nav-link:hover,
    .navbar-panel .nav-link.active {
      background: rgba(255,255,255,.13);
      color: white;
    }
    .admin-container { max-width: 1100px; }
    .eyebrow {
      color: var(--violeta);
      text-transform: uppercase;
      font-size: .75rem;
      font-weight: 750;
      letter-spacing: .11em;
    }
    .card {
      border: 1px solid #e9e6f0;
      border-radius: 1.05rem;
      box-shadow: 0 6px 22px rgba(33,27,56,.035);
    }
    .btn-brand {
      background: var(--violeta);
      color: white;
      border-color: var(--violeta);
    }
    .btn-brand:hover, .btn-brand:focus {
      background: var(--violeta-oscuro);
      color: white;
      border-color: var(--violeta-oscuro);
    }
    .form-control:focus, .form-check-input:focus {
      border-color: #a991de;
      box-shadow: 0 0 0 .2rem rgba(112,72,198,.12);
    }
    .form-check-input:checked {
      background-color: var(--violeta);
      border-color: var(--violeta);
    }
    .avatar-usuario {
      width: 55px;
      height: 55px;
      background: #ebe5fa;
      color: #5d3ca7;
      border-radius: 16px;
      display: grid;
      place-items: center;
      flex: none;
      font-size: 1.45rem;
      font-weight: 750;
    }
    .role-card {
      display: flex;
      align-items: flex-start;
      gap: .85rem;
      padding: 1rem;
      border: 1px solid #e9e6f0;
      border-radius: .9rem;
      background: #fff;
      height: 100%;
      cursor: pointer;
      transition: border-color .15s, background-color .15s;
    }
    .role-card:has(.form-check-input:checked) {
      background: #f5f0ff;
      border-color: #bea4f1;
    }
    .role-card:has(.form-check-input:disabled) { cursor: default; }
    .role-card .form-check-input { margin-top: .22rem; flex: none; }
    .role-card .role-name { font-weight: 650; }
    .role-card .role-description { color: #716c81; font-size: .85rem; }
    .section-subtitle { color: #77728c; }
    .selection-count { background: #efe6ff; color: #6940ae; }
    .sticky-actions {
      position: sticky;
      bottom: 0;
      z-index: 5;
      background: rgba(246,245,250,.97);
      border-top: 1px solid #e9e6f0;
      backdrop-filter: blur(12px);
    }
    @media (max-width: 576px) { .page-title { font-size: 1.7rem; } }
  </style>
</head>
<body>
<%
  // Estos datos los envía AdminController.editForm.
  const rolesActuales = Array.isArray(usuario.roles) ? usuario.roles : [];
  const catalogo = Array.isArray(rolesDisponibles) ? rolesDisponibles : [];
  const cuentaPropia = Number(usuario.id) === Number(user.id);
  const adminPropio = cuentaPropia && rolesActuales.includes('Administrador');
  const inicial = (usuario.nombre || '?').trim().charAt(0).toUpperCase() || '?';
  const fecha = usuario.creado_en ? new Date(usuario.creado_en) : null;
  const fechaTexto = fecha && !Number.isNaN(fecha.getTime())
    ? fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric' })
    : 'No disponible';
%>

<nav class="navbar navbar-expand-lg navbar-dark navbar-panel py-3">
  <div class="container-fluid admin-container px-3 px-lg-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/admin">
      <span class="bg-white bg-opacity-10 rounded-3 px-2 py-1"><i class="bi bi-grid-1x2-fill"></i></span>
      Sistema Integral <span class="d-none d-sm-inline text-white-50 fw-normal fs-6">/ Admin</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navAdmin"
            aria-controls="navAdmin" aria-expanded="false" aria-label="Mostrar navegación">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navAdmin">
      <ul class="navbar-nav ms-lg-auto align-items-lg-center gap-lg-1">
        <li class="nav-item"><a class="nav-link active" href="/admin"><i class="bi bi-people me-1"></i> Usuarios</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/menu/productos"><i class="bi bi-egg-fried me-1"></i> Platillos</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/menu/categorias"><i class="bi bi-journal-text me-1"></i> Menús</a></li>
        <li class="nav-item"><a class="nav-link" href="/admin/inflables"><i class="bi bi-balloon me-1"></i> Inflables</a></li>
        <li class="nav-item"><a class="nav-link" href="/panel-imagenes"><i class="bi bi-image me-1"></i> Imágenes</a></li>
        <li class="nav-item"><a class="nav-link text-warning" href="/logout"><i class="bi bi-box-arrow-right me-1"></i> Salir</a></li>
      </ul>
    </div>
  </div>
</nav>

<main class="container-fluid admin-container px-3 px-lg-4 py-4 py-lg-5">
  <a href="/admin" class="small text-decoration-none d-inline-flex align-items-center gap-2 mb-3" style="color:var(--violeta)">
    <i class="bi bi-arrow-left"></i> Volver a gestión de usuarios
  </a>

  <div class="eyebrow mb-2">Administración de personal</div>
  <h1 class="page-title fw-bold mb-1">Editar usuario</h1>
  <p class="section-subtitle mb-4">Actualiza los datos de la cuenta y asigna los roles que necesite.</p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
  <% } %>

  <div class="card mb-4">
    <div class="card-body p-4 d-flex flex-wrap align-items-center gap-3">
      <div class="avatar-usuario"><%= inicial %></div>
      <div class="flex-grow-1">
        <div class="fw-bold fs-5"><%= usuario.nombre %>
          <% if (cuentaPropia) { %><span class="badge text-bg-light border ms-1 fs-6">Tu cuenta</span><% } %>
        </div>
        <div class="section-subtitle small"><%= usuario.email %></div>
        <div class="section-subtitle small">ID #<%= usuario.id %> &middot; Registrado: <%= fechaTexto %></div>
      </div>
      <span class="badge rounded-pill <%= Number(usuario.activo) === 1 ? 'text-bg-success' : 'text-bg-secondary' %>">
        <%= Number(usuario.activo) === 1 ? 'Cuenta activa' : 'Cuenta inactiva' %>
      </span>
    </div>
  </div>

  <form id="formEditarUsuario" action="/admin/users/update/<%= usuario.id %>" method="POST">
    <!-- Si un administrador se edita a sí mismo, conserva obligatoriamente ese rol.
         El input oculto se envía porque el checkbox bloqueado no se envía en HTML. -->
    <% if (adminPropio) { %>
      <input type="hidden" name="roles" value="Administrador">
    <% } %>

    <section class="card mb-4" aria-labelledby="tituloDatos">
      <div class="card-body p-4 p-lg-5">
        <div class="d-flex align-items-center gap-3 mb-4">
          <span class="rounded-3 p-2" style="background:#eee7fc;color:#6541b4"><i class="bi bi-person-vcard fs-4"></i></span>
          <div>
            <h2 id="tituloDatos" class="h5 fw-bold mb-1">Datos personales</h2>
            <p class="small section-subtitle mb-0">Información básica del empleado.</p>
          </div>
        </div>

        <div class="row g-3">
          <div class="col-md-6">
            <label for="nombre" class="form-label fw-semibold">Nombre completo</label>
            <input type="text" class="form-control form-control-lg" id="nombre" name="nombre"
                   value="<%= usuario.nombre %>" maxlength="100" autocomplete="name" required>
          </div>
          <div class="col-md-6">
            <label for="email" class="form-label fw-semibold">Correo electrónico</label>
            <input type="email" class="form-control form-control-lg" id="email" name="email"
                   value="<%= usuario.email %>" maxlength="150" autocomplete="email" required>
          </div>
        </div>
      </div>
    </section>

    <section class="card mb-4" aria-labelledby="tituloRoles">
      <div class="card-body p-4 p-lg-5">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2">
          <div class="d-flex align-items-center gap-3">
            <span class="rounded-3 p-2" style="background:#eee7fc;color:#6541b4"><i class="bi bi-shield-check fs-4"></i></span>
            <div>
              <h2 id="tituloRoles" class="h5 fw-bold mb-1">Roles y permisos</h2>
              <p class="small section-subtitle mb-0">Puedes seleccionar varios roles para un mismo empleado.</p>
            </div>
          </div>
          <span class="badge rounded-pill selection-count align-self-start px-3 py-2" id="contadorRoles" aria-live="polite">0 seleccionados</span>
        </div>

        <p class="small section-subtitle mt-3 mb-4">Los permisos se aplicarán al guardar. El rol <strong>Aspirante</strong> normalmente se utiliza mientras el empleado no tiene funciones asignadas.</p>

        <% if (catalogo.length === 0) { %>
          <div class="alert alert-warning mb-0" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            No hay roles disponibles. Comprueba que la tabla <code>rol</code> tenga registros y que el controlador envíe <code>rolesDisponibles</code>.
          </div>
        <% } else { %>
          <div class="row g-3" id="listaRoles">
            <% catalogo.forEach(rol => {
              const asignado = rolesActuales.includes(rol.nombre);
              const protegido = adminPropio && rol.nombre === 'Administrador';
            %>
              <div class="col-12 col-md-6">
                <label class="role-card" for="rol-<%= rol.id %>">
                  <input type="checkbox" class="form-check-input rol-check" id="rol-<%= rol.id %>"
                         name="roles" value="<%= rol.nombre %>"
                         <%= asignado ? 'checked' : '' %> <%= protegido ? 'disabled' : '' %>>
                  <span class="d-block flex-grow-1">
                    <span class="role-name d-block"><%= rol.nombre %></span>
                    <span class="role-description d-block mt-1"><%= rol.descripcion || 'Sin descripción adicional' %></span>
                    <% if (protegido) { %>
                      <span class="badge text-bg-light border mt-2"><i class="bi bi-lock-fill me-1"></i> No puedes quitar tu propio acceso</span>
                    <% } %>
                  </span>
                </label>
              </div>
            <% }); %>
          </div>
          <div id="errorRoles" class="alert alert-danger mt-3 mb-0 d-none" role="alert">
            Debes seleccionar al menos un rol antes de guardar.
          </div>
        <% } %>
      </div>
    </section>

    <div class="sticky-actions rounded-3 p-3 mb-4 d-flex flex-column flex-sm-row justify-content-end align-items-stretch align-items-sm-center gap-2">
      <a href="/admin" class="btn btn-outline-secondary btn-lg rounded-3 px-4 order-2 order-sm-1">
        Cancelar
      </a>
      <button type="submit" id="btnGuardar" class="btn btn-brand btn-lg rounded-3 px-4 order-1 order-sm-2"
              <%= catalogo.length === 0 ? 'disabled' : '' %>>
        <i class="bi bi-check2-circle me-2"></i> Guardar cambios
      </button>
    </div>
  </form>

  <p class="small text-center section-subtitle"><i class="bi bi-shield-lock me-1"></i> Solo un administrador autorizado puede modificar estos datos.</p>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const formulario = document.getElementById('formEditarUsuario');
  const checks = [...document.querySelectorAll('.rol-check')];
  const hiddenRoles = [...formulario.querySelectorAll('input[type="hidden"][name="roles"]')];
  const contadorRoles = document.getElementById('contadorRoles');
  const errorRoles = document.getElementById('errorRoles');
  const btnGuardar = document.getElementById('btnGuardar');

  function rolesSeleccionados() {
    return [
      ...hiddenRoles.map(input => input.value),
      ...checks.filter(input => input.checked && !input.disabled).map(input => input.value)
    ];
  }

  function actualizarContador() {
    const total = new Set(rolesSeleccionados()).size;
    contadorRoles.textContent = total === 1 ? '1 seleccionado' : `${total} seleccionados`;
    if (total > 0 && errorRoles) errorRoles.classList.add('d-none');
  }

  checks.forEach(input => input.addEventListener('change', actualizarContador));
  actualizarContador();

  formulario.addEventListener('submit', (evento) => {
    if (rolesSeleccionados().length === 0) {
      evento.preventDefault();
      if (errorRoles) {
        errorRoles.classList.remove('d-none');
        errorRoles.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return;
    }

    if (!formulario.checkValidity()) return;
    btnGuardar.disabled = true;
    btnGuardar.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> Guardando...';
  });
</script>
</body>
</html>
